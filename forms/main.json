                "class": "Layout",
                "name": "lyDisplays",
                "align": "top",
                "height": 300,
                "padding": [22, 14, 22, 0],
                "children": [
                  {
                    "class": "Layout",
                    "name": "lyDisplaysTitle",
                    "align": "top",
                    "height": 28,
                    "children": [
                      { "class": "Label", "name": "lblScreens", "style": "h2", "align": "left", "width": 50, "v_align": "trailing", "text": "Telas" },
