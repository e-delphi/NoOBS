                "cursor": "pointer",
                "on_click": "replay_click",
                "children": [
                  { "class": "Circle", "name": "dotReplay", "align": "left", "width": 7, "height": 7, "margins": [0, 14, 10, 14], "fill": "#36363C", "stroke_width": 0, "hit_test": false },
