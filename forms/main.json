              { "class": "Button", "name": "btnFullscreen", "style": "pl", "icon": "fullscreen", "icon_size": 18, "text": "", "align": "right", "width": 36, "margins": [6, 12, 0, 12], "on_click": "player_fullscreen" },
              { "class": "Button", "name": "btnTranscript", "style": "pl", "icon": "chat", "icon_size": 18, "text": "", "align": "right", "width": 36, "margins": [6, 12, 0, 12], "on_click": "player_transcript" },
              { "class": "Button", "name": "btnInfo", "style": "pl", "icon": "info", "icon_size": 18, "text": "", "align": "right", "width": 36, "margins": [6, 12, 0, 12], "on_click": "player_info" },
              { "class": "Button", "name": "btnCaptions", "style": "pl", "text": "CC", "align": "right", "width": 40, "margins": [6, 12, 0, 12], "on_click": "player_captions" },
              { "class": "Button", "name": "btnSpeed", "style": "pl", "text": "1×", "align": "right", "width": 54, "margins": [6, 12, 0, 12], "on_click": "player_speed" },
              { "class": "TrackBar", "name": "trkVolume", "align": "right", "width": 90, "margins": [4, 18, 6, 18], "min": 0, "max": 200, "value": 100, "on_change": "player_volume" },
              { "class": "Button", "name": "btnMute", "style": "pl", "icon": "volume", "icon_size": 18, "text": "", "align": "right", "width": 36, "margins": [6, 12, 0, 12], "on_click": "player_mute" },
              { "class": "Label", "name": "lblPlayerClock", "style": "pl_time", "align": "right", "width": 80, "margins": [10, 0, 6, 0], "h_align": "trailing", "text": "" },
              { "class": "Waveform", "name": "wavPlayer", "align": "client", "margins": [8, 14, 8, 14], "on_seek": "player_seek" }
            ]
          },
          {
            "class": "FrameView",
            "name": "frmVideo",
            "align": "client",
            "on_resize": "player_stage_resize"
          },
          { "class": "Label", "name": "lblPlayerLoading", "style": "pl_time", "align": "center", "width": 400, "height": 40, "h_align": "center", "hit_test": false, "text": "" },
          { "class": "Label", "name": "lblCaption", "style": "pl_caption", "align": "bottom", "height": 60, "margins": [80, 0, 80, 90], "h_align": "center", "wrap": true, "hit_test": false, "visible": false, "text": "" }
        ]
      }
    ]
  }
}
