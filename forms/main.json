{
  "iron": 1,
  "root": {
    "class": "Form",
    "name": "frmMain",
    "caption": "NoOBS",
    "width": 1600,
    "height": 900,
    "on_close_query": "close_query",
    "children": [
      {
        "class": "Panel",
        "name": "pnlSources",
        "style": "column",
        "align": "left",
        "width": 400,
        "children": [
          { "class": "Rectangle", "name": "lnSourcesEdge", "style": "edge", "align": "right", "width": 1 },
          {
            "class": "Panel",
            "name": "pnlUpdate",
            "style": "box",
            "align": "top",
            "height": 66,
            "margins": [13, 13, 13, 0],
            "padding": [14, 10, 8, 10],
            "visible": false,
            "children": [
              { "class": "Button", "name": "btnUpdClose", "style": "tool", "icon": "close", "icon_size": 12, "text": "", "align": "right", "width": 26, "margins": [0, 0, 0, 20], "on_click": "update_close" },
              { "class": "Button", "name": "btnUpdOpen", "text": "Abrir página", "align": "right", "width": 110, "margins": [8, 6, 6, 6], "on_click": "update_open" },
              { "class": "Label", "name": "lblUpdTitle", "style": "row", "align": "top", "height": 20, "text": "" },
              { "class": "Label", "name": "lblUpdBody", "style": "sub", "align": "client", "wrap": true, "text": "" }
            ]
          },
          {
            "class": "Panel",
            "name": "pnlRecordCard",
            "style": "card",
            "align": "top",
            "height": 286,
            "margins": [13, 15, 13, 14],
            "padding": [14, 14, 14, 10],
            "children": [
              {
                "class": "Layout",
                "name": "lyCardHeader",
                "align": "top",
                "height": 28,
                "children": [
                  { "class": "Circle", "name": "dotStatus", "align": "left", "width": 8, "height": 8, "margins": [0, 10, 9, 10], "fill": "green", "stroke_width": 0 },
                  { "class": "Button", "name": "btnSettings", "style": "tool", "icon": "settings", "icon_size": 16, "text": "", "align": "right", "width": 28, "on_click": "settings_click" },
              { "class": "Label", "name": "lblTrChip", "style": "count", "align": "right", "width": 64, "margins": [0, 0, 8, 0], "h_align": "trailing", "visible": false, "text": "" },
                  { "class": "Label", "name": "lblStatus", "style": "status", "align": "client", "text": "Pronto para gravar", "text_case": "upper", "letter_spacing": 1.8 }
                ]
              },
              {
                "class": "FlowLayout",
                "name": "lyTimer",
                "align": "top",
                "height": 38,
                "margins": [0, 11, 0, 0],
                "h_align": "center",
                "gap": 1,
                "children": [
                  { "class": "Label", "name": "lblTimer", "style": "timer", "text": "00:00:00", "width": 190, "height": 38, "v_align": "trailing", "h_align": "trailing" },
                  { "class": "Label", "name": "lblTimerMs", "style": "timer_ms", "text": ".00", "width": 40, "height": 34, "v_align": "trailing" }
                ]
              },
              { "class": "Label", "name": "lblSize", "style": "size", "align": "top", "height": 13, "margins": [0, 4, 0, 0], "h_align": "center", "text": "" },
              {
                "class": "FlowLayout",
                "name": "lyRecord",
                "align": "top",
                "height": 72,
                "margins": [0, 6, 0, 0],
                "h_align": "center",
                "children": [
                  { "class": "RecordButton", "name": "btnRecord", "width": 72, "height": 72, "on_click": "record_click" }
                ]
              },
              { "class": "Label", "name": "lblRecordAction", "style": "action", "align": "top", "height": 15, "margins": [0, 12, 0, 0], "h_align": "center", "text": "Iniciar gravação", "text_case": "upper", "letter_spacing": 2.4 },
              { "class": "Rectangle", "name": "lnCard", "style": "sep", "align": "top", "height": 1, "margins": [-6, 13, -6, 0] },
              {
                "class": "Panel",
                "name": "pnlReplay",
                "style": "flat",
                "align": "top",
                "height": 49,
                "margins": [-6, 0, -6, 0],
                "padding": [10, 7, 6, 7],
                "cursor": "pointer",
                "on_click": "replay_click",
                "children": [
                  { "class": "Circle", "name": "dotReplay", "align": "left", "width": 7, "height": 7, "margins": [0, 14, 10, 14], "fill": "border_2", "stroke_width": 0, "hit_test": false },
                  { "class": "Button", "name": "btnPause", "style": "tool", "icon": "pause", "icon_size": 14, "text": "", "align": "right", "width": 28, "margins": [6, 3, 0, 4], "on_click": "pause_click" },
                  { "class": "Button", "name": "btnCapture", "style": "tool", "icon": "window", "icon_size": 14, "text": "", "align": "right", "width": 28, "margins": [6, 3, 0, 4], "on_click": "capture_click" },
                  { "class": "Switch", "name": "swReplay", "align": "right", "width": 36, "margins": [10, 0, 10, 0], "on_change": "replay_switch" },
                  { "class": "Button", "name": "btnReplaySave", "style": "tool", "icon": "download", "icon_size": 14, "text": "", "align": "right", "width": 28, "margins": [6, 3, 0, 4], "visible": false, "on_click": "replay_save_click" },
                  {
                    "class": "Layout",
                    "name": "lyReplayText",
                    "align": "client",
                    "hit_test": false,
                    "children": [
                      { "class": "Label", "name": "lblReplay", "style": "row", "align": "top", "height": 18, "text": "Buffer em memória" },
                      { "class": "Label", "name": "lblReplayStatus", "style": "sub", "align": "top", "height": 16, "text": "Desligado" }
                    ]
                  }
                ]
              }
            ]
          },
          { "class": "Rectangle", "name": "lnSources", "style": "sep", "align": "top", "height": 1 },
          {
            "class": "Panel",
            "name": "pnlLegend",
            "style": "column",
            "align": "bottom",
            "height": 0,
            "padding": [12, 0, 12, 18],
            "children": [
              { "class": "Rectangle", "name": "lnLegend", "style": "sep", "align": "top", "height": 1, "margins": [0, 0, 0, 0] },
              {
                "class": "Layout",
                "name": "lyLegendTitle",
                "align": "top",
                "height": 13,
                "margins": [6, 14, 6, 8],
                "children": [
                  { "class": "Label", "name": "lblLegendTitle", "style": "section", "align": "client", "text": "Faixas de áudio", "text_case": "upper", "letter_spacing": 1 }
                ]
              },
              { "class": "Layout", "name": "lyLegend", "align": "client" }
            ]
          },
          {
            "class": "ScrollBox",
            "name": "scrSources",
            "align": "client",
            "padding": [0, 0, 0, 0],
            "children": [
              {
                "class": "Layout",
                "name": "lySources",
                "align": "top",
                "height": 400,
                "children": [
                  {
                    "class": "Layout",
                    "name": "lyMicsTitle",
                    "align": "top",
                    "height": 15,
                    "margins": [18, 14, 18, 6],
                    "children": [
                      { "class": "Label", "name": "lblMicsCount", "style": "count", "align": "right", "width": 60, "h_align": "trailing", "text": "— / —" },
                      { "class": "Label", "name": "lblMicsTitle", "style": "section", "align": "client", "text": "Microfones", "text_case": "upper", "letter_spacing": 1 }
                    ]
                  },
                  { "class": "Layout", "name": "lyMics", "align": "top", "height": 0, "margins": [12, 0, 12, 0] },
                  {
                    "class": "Layout",
                    "name": "lySpeakersTitle",
                    "align": "top",
                    "height": 15,
                    "margins": [18, 18, 18, 6],
                    "children": [
                      { "class": "Label", "name": "lblSpeakersCount", "style": "count", "align": "right", "width": 60, "h_align": "trailing", "text": "— / —" },
                      { "class": "Label", "name": "lblSpeakersTitle", "style": "section", "align": "client", "text": "Alto-falantes", "text_case": "upper", "letter_spacing": 1 }
                    ]
                  },
                  { "class": "Layout", "name": "lySpeakers", "align": "top", "height": 0, "margins": [12, 0, 12, 0] }
                ]
              }
            ]
          }
        ]
      },
      {
        "class": "Panel",
        "name": "pnlRecordings",
        "style": "pane",
        "align": "client",
        "children": [
          {
            "class": "ScrollBox",
            "name": "scrRecordings",
            "align": "client",
            "children": [
              {
                "class": "Layout",
                "name": "lyDisplays",
                "align": "top",
                "height": 293,
                "padding": [22, 14, 22, 0],
                "children": [
                  {
                    "class": "Layout",
                    "name": "lyDisplaysTitle",
                    "align": "top",
                    "height": 21,
                    "children": [
                      { "class": "Label", "name": "lblScreens", "style": "h2", "align": "left", "width": 50, "v_align": "trailing", "text": "Telas" },
                      { "class": "Label", "name": "lblScreensCount", "style": "count", "align": "right", "width": 60, "h_align": "trailing", "text": "— / —" },
                      { "class": "Label", "name": "lblScreensMeta", "style": "meta", "align": "client", "margins": [8, 0, 0, 2], "v_align": "trailing", "text": "" }
                    ]
                  },
                  { "class": "ScreenLayout", "name": "scrDisplays", "align": "top", "height": 250, "margins": [0, 8, 0, 0], "on_change": "display_change" }
                ]
              },
              {
                "class": "Layout",
                "name": "lyLibrary",
                "align": "top",
                "height": 400,
                "padding": [22, 20, 22, 30],
                "on_resize": "library_resize", "on_pointer_up": "library_background", "hit_test": true,
                "children": [
                  {
                    "class": "Layout",
                    "name": "lyLibHeader",
                    "align": "top",
                    "height": 22,
                    "children": [
                      { "class": "Label", "name": "lblRecordings", "style": "h2", "align": "left", "width": 110, "v_align": "trailing", "text": "Gravações" },
                      { "class": "Label", "name": "lblLibMeta", "style": "meta", "align": "client", "margins": [8, 0, 0, 2], "v_align": "trailing", "text": "" }
                    ]
                  },
                  {
                    "class": "Layout",
                    "name": "lyLibTools",
                    "align": "top",
                    "height": 30,
                    "margins": [0, 10, 0, 0],
                    "children": [
                      { "class": "Edit", "name": "edLibSearch", "align": "left", "width": 220, "placeholder": "Buscar...", "on_change": "library_search" },
                      { "class": "Button", "name": "btnLibOpenDir", "style": "tool", "icon": "lib-folder", "icon_size": 16, "text": "", "align": "left", "width": 30, "margins": [8, 0, 0, 0], "on_click": "library_open_dir" },
                      { "class": "Button", "name": "btnLibNewFolder", "style": "tool", "icon": "lib-folder-plus", "icon_size": 16, "text": "", "align": "left", "width": 30, "margins": [8, 0, 0, 0], "on_click": "library_new_folder" },
                      { "class": "Button", "name": "btnLibMerge", "style": "tool", "icon": "lib-merge", "icon_size": 15, "text": "", "align": "left", "width": 30, "margins": [8, 0, 0, 0], "on_click": "library_merge" },
                      { "class": "Button", "name": "btnLibExport", "style": "tool", "icon": "lib-download", "icon_size": 16, "text": "", "align": "left", "width": 30, "margins": [8, 0, 0, 0], "on_click": "library_export" },
                      { "class": "Button", "name": "btnLibDelete", "style": "tool", "icon": "lib-trash", "icon_size": 16, "text": "", "align": "left", "width": 30, "margins": [8, 0, 0, 0], "on_click": "library_delete", "accepts_drops": true, "on_drag_drop": "library_trash_drop" }
                    ]
                  },
                  { "class": "Breadcrumb", "name": "brdLib", "align": "top", "height": 28, "margins": [0, 16, 0, 0], "visible": false, "items": "", "on_change": "library_crumb" },
                  { "class": "Label", "name": "lblLibEmpty", "style": "body", "align": "top", "height": 60, "h_align": "center", "visible": false, "text": "" },
                  { "class": "Layout", "name": "lyLibContent", "align": "top", "height": 0, "on_pointer_up": "library_background", "hit_test": true }
                ]
              }

            ]
          }
        ]
      }
    ]
  }
}
