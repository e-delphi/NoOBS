            ]
          },
          {
            "class": "ScrollBox",
            "name": "scrSettings",
            "align": "client",
            "children": [
              { "class": "Layout", "name": "lySettings", "align": "top", "height": 100, "padding": [32, 4, 40, 40], "on_resize": "settings_resize" }
            ]
          }
            ]
          }
        ]
      }
