          {
            "class": "Panel",
            "name": "pnlUpdate",
            "style": "box",
            "align": "top",
            "height": 66,
            "margins": [13, 13, 13, 0],
            "padding": [14, 10, 8, 10],
            "visible": false,
            "children": [
              { "class": "Button", "name": "btnUpdClose", "style": "tool", "icon": "close", "icon_size": 12, "text": "", "align": "right", "width": 26, "margins": [0, 0, 0, 20], "on_click": "update_close" },
