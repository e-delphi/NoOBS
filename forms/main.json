                "class": "Layout",
                "name": "lyLibrary",
                "align": "top",
                "height": 400,
                "padding": [22, 26, 22, 30],
                "on_resize": "library_resize",
                "children": [
                  {
                    "class": "Layout",
                    "name": "lyLibHeader",
                    "align": "top",
                    "height": 28,
                    "children": [
                      { "class": "Label", "name": "lblRecordings", "style": "h2", "align": "left", "width": 110, "v_align": "trailing", "text": "Gravações" },
                      { "class": "Label", "name": "lblLibMeta", "style": "meta", "align": "client", "margins": [8, 0, 0, 2], "v_align": "trailing", "text": "" }
                    ]
                  },
                  {
                    "class": "Layout",
                    "name": "lyLibTools",
                    "align": "top",
                    "height": 34,
                    "margins": [0, 14, 0, 0],
