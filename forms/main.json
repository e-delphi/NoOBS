                "class": "Layout",
                "name": "lyPickerHeader",
                "align": "top",
                "height": 52,
                "children": [
                  { "class": "Button", "name": "btnPickerClose", "style": "tool", "icon": "close", "icon_size": 14, "text": "", "align": "right", "width": 28, "margins": [6, 2, 0, 22], "on_click": "picker_close" },
                  { "class": "Button", "name": "btnPickerRefresh", "style": "tool", "icon": "refresh", "icon_size": 14, "text": "", "align": "right", "width": 28, "margins": [6, 2, 0, 22], "on_click": "picker_refresh" },
