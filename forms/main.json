        "class": "Panel",
        "name": "pnlPlayer",
        "style": "player",
        "align": "contents",
        "visible": false,
        "children": [
          {
            "class": "Panel",
            "name": "pnlPlayerSide",
            "style": "plside",
            "align": "right",
