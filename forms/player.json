{
  "iron": 1,
  "root": {
    "class": "Form",
    "name": "frmPlayer",
    "width": 1600,
    "height": 900,
    "children": [
      {
        "class": "Panel",
        "name": "pnlPlayer",
        "style": "player",
        "align": "client",
        "children": [
          {
            "class": "Panel",
            "name": "pnlPlayerSide",
            "style": "plside",
            "align": "right",
            "width": 360,
            "visible": false,
            "children": [
              { "class": "Rectangle", "name": "recSideEdge", "style": "pl_line", "align": "left", "width": 1, "hit_test": false },
              {
                "class": "Layout",
                "name": "lySideBody",
                "align": "client",
                "padding": [0, 56, 0, 60],
                "children": [
              {
                "class": "Layout",
                "name": "lyPlayerSideHead",
                "align": "top",
                "height": 45,
                "children": [
                  { "class": "Rectangle", "name": "recSideHeadLine", "style": "pl_line", "align": "bottom", "height": 1, "hit_test": false },
                  { "class": "Button", "name": "btnSideClose", "style": "pl_side_x", "text": "×", "align": "right", "width": 24, "margins": [0, 10, 14, 10], "on_click": "player_side_close" },
                  { "class": "Label", "name": "lblSideTitle", "style": "pl_side_title", "align": "client", "margins": [14, 0, 0, 0], "text_case": "upper", "letter_spacing": 0.36, "text": "" }
                ]
              },
              {
                "class": "Layout",
                "name": "lyTrSearch",
                "align": "top",
                "height": 47,
                "visible": false,
                "children": [
                  { "class": "Rectangle", "name": "recTrSearchLine", "style": "pl_line", "align": "bottom", "height": 1, "hit_test": false },
                  { "class": "Edit", "name": "edTrSearch", "style": "pl_search", "align": "client", "margins": [12, 8, 12, 8], "placeholder": "Buscar na transcrição...", "on_change": "player_tr_search" }
                ]
              },
              {
                "class": "ScrollBox",
                "name": "scrPlayerSide",
                "align": "client",
                "padding": [0, 0, 0, 0],
                "children": [
                  { "class": "Layout", "name": "lySide", "align": "top", "height": 100, "padding": [14, 14, 14, 14] }
                ]
              }
                ]
              }
            ]
          },
          {
            "class": "Layout",
            "name": "lyStage",
            "align": "client",
            "clip_children": true,
            "children": [
              { "class": "FrameView", "name": "frmVideo", "align": "contents", "on_resize": "player_stage_resize" },
              { "class": "Label", "name": "lblCaption", "style": "pl_caption", "align": "bottom", "height": 60, "margins": [80, 0, 80, 92], "h_align": "center", "v_align": "trailing", "wrap": true, "outline": "black/90", "outline_width": 3, "hit_test": false, "visible": false, "text": "" },
              { "class": "Label", "name": "lblPlayerZoom", "style": "pl_zoom", "align": "none", "width": 50, "height": 22, "h_align": "center", "hit_test": false, "visible": false, "text": "" },
              {
                "class": "Panel",
                "name": "pnlPauseFlash",
                "style": "pl_flash",
                "align": "center",
                "width": 180,
                "height": 180,
                "fill": "black/45",
                "fill_mid": "black/30",
                "fill_mid_at": 0.49,
                "fill2": "black/0",
                "gradient_radial": true,
                "hit_test": false,
                "visible": false,
                "children": [
                  { "class": "Circle", "name": "cirPauseFlash", "align": "center", "width": 90, "height": 90, "fill": "black/55", "stroke": "white/95", "stroke_width": 4, "hit_test": false },
                  { "class": "Rectangle", "name": "recPauseFlash1", "align": "none", "left": 76, "top": 70, "width": 9, "height": 40, "fill": "white/95", "stroke_width": 0, "radius": 2, "hit_test": false },
                  { "class": "Rectangle", "name": "recPauseFlash2", "align": "none", "left": 95, "top": 70, "width": 9, "height": 40, "fill": "white/95", "stroke_width": 0, "radius": 2, "hit_test": false }
                ]
              },
              {
                "class": "Panel",
                "name": "pnlPlayerLoading",
                "style": "pl_loading",
                "align": "contents",
                "hit_test": false,
                "visible": false,
                "children": [
                  {
                    "class": "Layout",
                    "name": "lyPlayerLoading",
                    "align": "center",
                    "width": 400,
                    "height": 70,
                    "children": [
                      { "class": "ActivityIndicator", "name": "aniPlayerLoading", "align": "top", "height": 36, "active": true, "accent_color": "green", "hit_test": false },
                      { "class": "Label", "name": "lblPlayerLoading", "style": "pl_loading", "align": "top", "height": 20, "margins": [0, 14, 0, 0], "h_align": "center", "hit_test": false, "text": "" }
                    ]
                  }
                ]
              }
            ]
          },
              {
                "class": "Layout",
                "name": "lyChrome",
                "align": "contents",
                "children": [
              {
                "class": "Panel",
                "name": "pnlPlayerHead",
                "style": "pl_head",
                "align": "top",
                "height": 62,
                "padding": [16, 12, 16, 18],
                "fill": "black/70",
                "fill_mid": "black/40",
                "fill_mid_at": 0.6,
                "fill2": "black/0",
                "gradient_angle": 180,
                "children": [
                  { "class": "Button", "name": "btnPlayerClose", "style": "pl_close", "text": "×", "align": "right", "width": 32, "on_click": "player_close" },
                  {
                    "class": "Panel",
                    "name": "pnlPlayerPaused",
                    "style": "pl_badge",
                    "align": "right",
                    "width": 90,
                    "margins": [12, 4, 12, 4],
                    "hit_test": false,
                    "visible": false,
                    "children": [
                      { "class": "Rectangle", "name": "recPaused1", "align": "none", "left": 8, "top": 8, "width": 2.5, "height": 8, "fill": "white/95", "stroke_width": 0, "radius": 0.5, "hit_test": false },
                      { "class": "Rectangle", "name": "recPaused2", "align": "none", "left": 13.5, "top": 8, "width": 2.5, "height": 8, "fill": "white/95", "stroke_width": 0, "radius": 0.5, "hit_test": false },
                      { "class": "Label", "name": "lblPlayerPaused", "style": "pl_badge", "align": "client", "margins": [23, 0, 0, 0], "hit_test": false, "letter_spacing": 0.44, "text": "PAUSADO" }
                    ]
                  },
                  { "class": "Label", "name": "lblPlayerTitle", "style": "pl_title", "align": "client", "text": "" }
                ]
              },
              {
                "class": "Panel",
                "name": "pnlPlayerBar",
                "style": "pl_head",
                "align": "bottom",
                "height": 64,
                "padding": [16, 18, 16, 14],
                "fill": "black/75",
                "fill_mid": "black/40",
                "fill_mid_at": 0.6,
                "fill2": "black/0",
                "gradient_angle": 0,
                "children": [
                  { "class": "Button", "name": "btnPlay", "style": "pl", "icon": "pl-pause", "icon_size": 18, "text": "", "align": "left", "width": 32, "on_click": "player_play" },
                  { "class": "Label", "name": "lblPlayerTime", "style": "pl_time", "align": "left", "width": 90, "margins": [12, 0, 0, 0], "h_align": "center", "text": "00:00 / 00:00" },
                  {
                    "class": "Layout",
                    "name": "lyPlayerClock",
                    "align": "left",
                    "width": 62,
                    "margins": [12, 0, 0, 0],
                    "hit_test": true,
                    "visible": false,
                    "children": [
                      { "class": "Button", "name": "btnClockIcon", "style": "pl_clock", "icon": "pl-clock", "icon_size": 13, "text": "", "align": "left", "width": 13, "hit_test": false },
                      { "class": "Label", "name": "lblPlayerClock", "style": "pl_clock", "align": "client", "margins": [4, 0, 0, 0], "hit_test": false, "text": "" }
                    ]
                  },
                  { "class": "Button", "name": "btnFullscreen", "style": "pl", "icon": "pl-fs-enter", "icon_size": 18, "text": "", "align": "right", "width": 32, "margins": [12, 0, 0, 0], "on_click": "player_fullscreen" },
                  { "class": "Button", "name": "btnInfo", "style": "pl_dim", "icon": "pl-info", "icon_size": 18, "text": "", "align": "right", "width": 32, "margins": [12, 0, 0, 0], "on_click": "player_info" },
                  { "class": "Button", "name": "btnCaptions", "style": "pl_dim", "icon": "pl-cc", "icon_size": 18, "text": "", "align": "right", "width": 32, "margins": [12, 0, 0, 0], "on_click": "player_captions" },
                  { "class": "Button", "name": "btnSpeed", "style": "pl_speed", "text": "1×", "align": "right", "width": 42, "margins": [12, 0, 0, 0], "on_click": "player_speed" },
                  { "class": "Button", "name": "btnMute", "style": "pl", "icon": "pl-vol-high", "icon_size": 18, "text": "", "align": "right", "width": 32, "margins": [12, 0, 0, 0], "on_click": "player_mute" },
                  { "class": "Waveform", "name": "wavPlayer", "align": "client", "margins": [12, 0, 0, 0], "seek_bar": true, "on_seek": "player_seek" }
                ]
              }
                ]
              },
              {
                "class": "Layout",
                "name": "lyVolPop",
                "align": "none",
                "width": 52,
                "height": 166,
                "padding": [0, 0, 0, 10],
                "hit_test": true,
                "visible": false,
                "children": [
                  {
                    "class": "Panel",
                    "name": "pnlVolPop",
                    "style": "pl_pop",
                    "align": "client",
                    "children": [
                      { "class": "Label", "name": "lblVolPct", "style": "pl_vol", "align": "top", "height": 16, "margins": [0, 9, 0, 0], "h_align": "center", "hit_test": false, "text": "100%" },
                      { "class": "TrackBar", "name": "trkVolume", "style": "pl_vol", "align": "top", "height": 110, "margins": [15, 8, 15, 0], "vertical": true, "min": 0, "max": 200, "frequency": 1, "value": 100, "thumb_size": 11, "track_size": 4, "solid_thumb": true, "limit": 100, "accent_color": "white/85", "danger_color": "danger_2", "on_change": "player_volume" }
                    ]
                  }
                ]
              },
              {
                "class": "Layout",
                "name": "lyCcPop",
                "align": "none",
                "width": 190,
                "height": 79,
                "padding": [0, 0, 0, 10],
                "hit_test": true,
                "visible": false,
                "children": [
                  {
                    "class": "Panel",
                    "name": "pnlCcPop",
                    "style": "pl_pop",
                    "align": "client",
                    "padding": [4, 4, 4, 4],
                    "children": [
                      {
                        "class": "Panel",
                        "name": "pnlCcCaptions",
                        "style": "pl_opt",
                        "align": "top",
                        "height": 29.5,
                        "padding": [12, 0, 12, 0],
                        "cursor": "pointer",
                        "on_click": "player_captions",
                        "children": [
                          { "class": "Label", "name": "lblCcCheck1", "style": "pl_opt", "align": "left", "width": 14, "h_align": "center", "hit_test": false, "text": "" },
                          { "class": "Label", "name": "lblCcKey1", "style": "pl_key", "align": "right", "width": 12, "h_align": "trailing", "hit_test": false, "text": "C" },
                          { "class": "Label", "name": "lblCcCaptions", "style": "pl_opt", "align": "client", "margins": [8, 0, 8, 0], "hit_test": false, "text": "Legenda sobre o vídeo" }
                        ]
                      },
                      {
                        "class": "Panel",
                        "name": "pnlCcTranscript",
                        "style": "pl_opt",
                        "align": "top",
                        "height": 29.5,
                        "margins": [0, 2, 0, 0],
                        "padding": [12, 0, 12, 0],
                        "cursor": "pointer",
                        "on_click": "player_transcript",
                        "children": [
                          { "class": "Label", "name": "lblCcCheck2", "style": "pl_opt", "align": "left", "width": 14, "h_align": "center", "hit_test": false, "text": "" },
                          { "class": "Label", "name": "lblCcTranscript", "style": "pl_opt", "align": "client", "margins": [8, 0, 0, 0], "hit_test": false, "text": "Painel de transcrição" }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "class": "Panel",
                "name": "pnlSpeedPop",
                "style": "pl_pop",
                "align": "none",
                "width": 84,
                "height": 287.5,
                "padding": [4, 4, 4, 4],
                "visible": false,
                "children": [
                  { "class": "Layout", "name": "lySpeedItems", "align": "client" }
                ]
              }
        ]
      }
    ]
  }
}
