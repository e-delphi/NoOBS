// Player da prova de conceito: o quadro chega pronto (RGBA) da thread de
// decode; aqui é só desenhar, a barra de controles e o painel de medidas.
import { Button, Slider } from "std-widgets.slint";

export component PlayerWindow inherits Window {
    title: "NoOBS — prova de conceito em Slint";
    preferred-width: 1280px;
    preferred-height: 780px;
    background: #101114;
    forward-focus: keys;

    in property <image> frame;
    in property <string> stats;
    in property <string> file-name;
    in property <float> duration: 1;
    in property <bool> playing;
    in property <string> time-text: "0:00 / 0:00";
    in-out property <float> position;
    in-out property <bool> show-stats: true;
    // Área do vídeo em px lógicos: o Rust multiplica pela escala e manda o
    // decoder converter já no tamanho da tela (4K inteiro não precisa sair da placa).
    out property <float> view-w: video.width / 1px;
    out property <float> view-h: video.height / 1px;

    callback toggle-play();
    callback seek(float);
    callback step(float);

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == " ") { root.toggle-play(); return accept; }
            if (e.text == Key.LeftArrow) { root.step(-5); return accept; }
            if (e.text == Key.RightArrow) { root.step(5); return accept; }
            if (e.text == "i") { root.show-stats = !root.show-stats; return accept; }
            reject
        }

        VerticalLayout {
            video := Rectangle {
                background: black;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.frame;
                    image-fit: contain;
                }
                TouchArea {
                    clicked => { keys.focus(); root.toggle-play(); }
                }
                if root.show-stats: Rectangle {
                    x: 10px;
                    y: 10px;
                    width: info.preferred-width + 16px;
                    height: info.preferred-height + 12px;
                    background: #000000b0;
                    border-radius: 6px;
                    info := Text {
                        x: 8px;
                        y: 6px;
                        text: root.stats;
                        color: #8fe39b;
                        font-size: 12px;
                        font-family: "Consolas";
                    }
                }
            }

            Rectangle {
                height: 56px;
                background: #1a1c21;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 16px;
                    spacing: 12px;
                    alignment: stretch;
                    Button {
                        width: 56px;
                        text: root.playing ? "❚❚" : "▶";
                        clicked => { keys.focus(); root.toggle-play(); }
                    }
                    Slider {
                        minimum: 0;
                        maximum: root.duration;
                        value <=> root.position;
                        changed(v) => { root.seek(v); }
                    }
                    Text {
                        text: root.time-text;
                        color: #d8dbe2;
                        vertical-alignment: center;
                        font-size: 14px;
                    }
                    Text {
                        text: root.file-name;
                        color: #7d828d;
                        vertical-alignment: center;
                        font-size: 12px;
                        overflow: elide;
                        max-width: 280px;
                    }
                }
            }
        }
    }
}
