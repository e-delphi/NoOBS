// Janela do NoOBS. Casca da versão web (`index.html` + `layout.css`): à
// esquerda a coluna de fontes (`.sources`: cartão de gravar + dispositivos),
// à direita telas e gravações (`.recordings`). Por cima de tudo, na ordem do
// `z-index` da web: diálogo de confirmação, avisos e a dica.
//
// As telas entram por fase (docs/ui-slint.md): a coluna de fontes na fase 1,
// as gravações na 2.

import { Theme } from "theme.slint";
import { T } from "i18n.slint";
import { Hints, HintBubble } from "widgets/hint.slint";
import { ToastItem, ToastStack } from "widgets/toast.slint";
import { Confirm, ConfirmDialog } from "widgets/confirm.slint";
import { Main, SourceItem, LegendItem, DisplayItem } from "screens/main_state.slint";
import { SourcesColumn } from "screens/sources.slint";
import { DisplaysBlock } from "screens/displays.slint";
import { WindowPicker } from "screens/window_picker.slint";
import { WindowCard, SavedArea } from "screens/main_state.slint";

export { Theme, T, Hints, Confirm, ToastItem, Main, SourceItem, LegendItem, DisplayItem, WindowCard, SavedArea }

export component AppWindow inherits Window {
    // `windowTitle` do config (barra de título e taskbar).
    in property <string> window-title: "NoOBS";
    title: root.window-title;
    background: Theme.bg;
    animate background { duration: 250ms; }
    default-font-family: Theme.font;
    default-font-size: Theme.font-size;
    min-width: 360px;
    min-height: 400px;

    in property <[ToastItem]> toasts;
    callback toast-clicked(int);

    init => { Main.win-h = self.height; }
    changed height => { Main.win-h = self.height; }

    // `@media (max-width: 760px)`: só a coluna de fontes.
    property <bool> narrow: root.width <= 760px;

    // Colunas posicionadas à mão, não num layout: a largura delas depende da
    // largura da janela, e num layout isso vira laço (a janela tira o mínimo
    // dela das colunas).
    // `.sources`: `grid-template-columns: minmax(360px, 400px) 1fr` — com
    // espaço sobrando o 1fr fica com o resto e a coluna fica nos 400.
    sources := Rectangle {
        x: 0;
        y: 0;
        width: root.narrow ? root.width : 400px;
        height: root.height;
        background: Theme.panel;
        animate background { duration: 250ms; }
        SourcesColumn {
            width: parent.width - (root.narrow ? 0 : 1px);
            height: parent.height;
        }
        // `border-right: 1px solid var(--border)` (some na janela estreita).
        Rectangle {
            visible: !root.narrow;
            x: parent.width - 1px;
            width: 1px;
            background: Theme.border;
        }
    }
    // `.recordings`: padding 0 22 18. As gravações entram na fase 2.
    recordings := Rectangle {
        visible: !root.narrow;
        x: sources.width;
        y: 0;
        width: root.width - sources.width;
        height: root.height;
        VerticalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-bottom: 18px;
            alignment: start;
            DisplaysBlock { }
        }
    }

    // Onda vermelha ao começar a gravar (`.record-ripple`): anel de 200 px
    // centrado no botão crescendo até cobrir a janela (escala = maior
    // distância até um canto / 94 + 1) e sumindo.
    if Main.ripple >= 0: Rectangle {
        property <length> max-r: sqrt(
            pow(max(Main.rec-btn-cx, root.width - Main.rec-btn-cx) / 1px, 2)
            + pow(max(Main.rec-btn-cy, root.height - Main.rec-btn-cy) / 1px, 2)) * 1px;
        property <float> s: Main.ripple * (self.max-r / 94px + 1);
        x: Main.rec-btn-cx - self.width / 2;
        y: Main.rec-btn-cy - self.height / 2;
        width: 200px * self.s;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 4px * self.s;
        border-color: #ef4444;
        opacity: 1 - Main.ripple;
        drop-shadow-blur: 30px * self.s;
        drop-shadow-color: rgba(239, 68, 68, 0.6);
    }

    // Camadas por cima: tamanho explícito, pra não restringirem a janela.
    WindowPicker {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    ConfirmDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    // `.toast-stack`: top/right 16px, acima de tudo menos a dica.
    ToastStack {
        x: root.width - self.width - 16px;
        y: 16px;
        width: min(380px, root.width - 32px);
        height: self.preferred-height;
        items: root.toasts;
        clicked(id) => { root.toast-clicked(id); }
    }

    HintBubble {
        win-w: root.width;
        win-h: root.height;
    }
}
