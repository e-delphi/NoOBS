// Textos do `lang\<código>.json` (fonte única das traduções). O Rust
// implementa `lookup`; `rev` sobe a cada troca de idioma — é a dependência que
// faz o Slint reavaliar todo texto ligado a `T.s(...)`.

export global T {
    in-out property <int> rev;
    pure callback lookup(int, string) -> string;

    public pure function s(key: string) -> string {
        return self.lookup(self.rev, key);
    }
}
