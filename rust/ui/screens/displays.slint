// Bloco "Telas" no topo das gravações (`.displays-block` / `.display-layout`
// do displays.css): monitores na posição real da área de trabalho e as
// webcams à direita, escalados pra caber na caixa, com a prévia ao vivo.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { HintTrigger } from "../widgets/hint.slint";
import { Icons, StrokeIcon } from "../widgets/icons.slint";
import { Main, DisplayItem } from "main_state.slint";

// `.display-rect`
component DisplayRect {
    in property <DisplayItem> item;
    in property <bool> locked;
    callback toggled(string, bool);

    opacity: root.item.enabled || ta.has-hover ? 1 : 0.5;
    animate opacity { duration: 150ms; }

    // Contorno: 1,5 px `--border-2`; marcado, verde com mais 1 px de anel
    // (`box-shadow: 0 0 0 1px`).
    if root.item.enabled: Rectangle {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        border-radius: 5px;
        border-width: 1px;
        border-color: Theme.success;
    }
    Rectangle {
        border-radius: 4px;
        clip: true;
        background: root.item.is-webcam ? @linear-gradient(135deg, #1e3a5f 0%, #0f2240 100%) : Theme.thumb-bg;
        if root.item.has-thumb && !root.item.is-webcam: Image {
            width: parent.width;
            height: parent.height;
            source: root.item.thumb;
            image-fit: cover;
        }
        if root.item.is-webcam: StrokeIcon {
            size: 28px;
            commands: Icons.camera;
            stroke: rgba(255, 255, 255, 0.85);
            opacity: 0.8;
        }
        // Na web a `<img>` (absoluta) pinta POR CIMA do rótulo (em fluxo):
        // com prévia, o nome do monitor não aparece.
        label := Rectangle {
            visible: root.item.is-webcam || !root.item.has-thumb;
            x: root.item.is-webcam ? 4px : (parent.width - self.width) / 2;
            y: root.item.is-webcam ? parent.height - self.height - 4px : (parent.height - self.height) / 2;
            width: lbl.preferred-width + 12px;
            height: lbl.preferred-height + 4px;
            border-radius: 3px;
            background: rgba(0, 0, 0, 0.6);
            lbl := Text {
                text: root.item.name != "" ? root.item.name : (root.item.is-webcam ? T.s("display.webcam") : T.s("display.monitor"));
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.2px;
                color: rgba(255, 255, 255, 0.92);
            }
        }
        // Check do canto (`.display-check`).
        Rectangle {
            x: parent.width - 20px;
            y: 4px;
            width: 16px;
            height: 16px;
            border-radius: 3px;
            border-width: 1.5px;
            border-color: root.item.enabled ? Theme.success : rgba(255, 255, 255, 0.75);
            background: root.item.enabled ? Theme.success : rgba(0, 0, 0, 0.55);
            drop-shadow-blur: 0;
            animate background, border-color { duration: 120ms; }
            if root.item.enabled: StrokeIcon {
                size: 10px;
                box: 16;
                thickness: 2.5;
                commands: Icons.check16;
                stroke: white;
            }
        }
        Rectangle {
            border-radius: 4px;
            border-width: 1.5px;
            border-color: root.item.enabled ? Theme.success : Theme.border-2;
            animate border-color { duration: 150ms; }
        }
    }
    ta := TouchArea {
        mouse-cursor: root.locked ? default : pointer;
        clicked => {
            if !root.locked {
                root.toggled(root.item.id, !root.item.enabled);
            }
        }
    }
}

export component DisplaysBlock {
    // `.displays-block`: 14 px em cima; título; a caixa de 250 px.
    VerticalLayout {
        padding-top: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                alignment: start;
                Text {
                    text: T.s("sources.monitors");
                    font-size: 16px;
                    font-weight: 600;
                    letter-spacing: -0.16px;
                    color: Theme.text;
                    vertical-alignment: bottom;
                }
                Text {
                    text: Main.mon-meta;
                    font-size: 11px;
                    color: Theme.text-3;
                    vertical-alignment: bottom;
                }
                if Main.mon-meta-warn: VerticalLayout {
                    alignment: end;
                    Rectangle {
                        width: 13px;
                        height: 13px;
                        StrokeIcon {
                            size: 13px;
                            thickness: 2.2;
                            commands: Icons.warn;
                            stroke: #f59e0b;
                        }
                        wta := TouchArea { mouse-cursor: help; }
                        HintTrigger {
                            hovered: wta.has-hover;
                            hint: Main.mon-meta-warn-hint;
                        }
                    }
                }
            }
            Text {
                text: Main.mon-count;
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-3;
                vertical-alignment: center;
            }
        }
        box := Rectangle {
            height: 250px;
            background: Theme.panel-2;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            clip: true;
            // Escala uniforme pra caber com 8 px de folga, centralizado.
            property <length> pad: 8px;
            property <float> avail-w: (self.width - 2 * self.pad) / 1px;
            property <float> avail-h: (self.height - 2 * self.pad) / 1px;
            property <float> scale: min(self.avail-w / Main.disp-total-w, self.avail-h / Main.disp-total-h);
            property <length> off-x: self.pad + (self.avail-w - Main.disp-total-w * self.scale) / 2 * 1px;
            property <length> off-y: self.pad + (self.avail-h - Main.disp-total-h * self.scale) / 2 * 1px;
            opacity: Main.recording ? 0.6 : 1;
            for d in Main.displays: DisplayRect {
                x: box.off-x + (d.x - Main.disp-min-x) * box.scale * 1px;
                y: box.off-y + (d.y - Main.disp-min-y) * box.scale * 1px;
                width: d.w * box.scale * 1px;
                height: d.h * box.scale * 1px;
                item: d;
                locked: Main.recording;
                toggled(id, on) => { Main.toggle-source(id, on); }
            }
        }
    }
}
