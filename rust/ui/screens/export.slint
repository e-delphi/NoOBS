// Tela de exportação (`index.html` #exportOverlay + `css/export.css`): ocupa
// a janela inteira, com o formulário numa coluna de até 880 px. A prévia é o
// motor de reprodução do player (`playback`) desenhando o quadro do cursor,
// com a moldura de recorte por cima; a linha do tempo (trechos + forma de
// onda) chega pronta do Rust como imagem da janela visível.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { HintTrigger } from "../widgets/hint.slint";
import { ScrollArea } from "../widgets/scroll.slint";
import { StrokeIcon, FillIcon } from "../widgets/icons.slint";
import { SelOpt, Form, CheckBox } from "../widgets/form.slint";
import { SelPop } from "../widgets/select_layer.slint";
import { Main } from "main_state.slint";
import { Ex, ExChk, ExRow, ExTick, ExCut, ExLabel } from "export_state.slint";

// Camada das dicas desta tela (acima das Configurações, abaixo do player).
global ExL {
    out property <int> layer: 4;
}

// `.export-field > label`: 12 px, 600, `--text-2`, linha 1,4.
component FLabel inherits Text {
    height: 16.8px;
    font-size: 12px;
    font-weight: 600;
    color: Theme.text-2;
    vertical-alignment: center;
}

// `.export-hint`: 11 px, `--text-3`, linha 1,45.
component FHint inherits Text {
    font-size: 11px;
    color: Theme.text-3;
    wrap: word-wrap;
    line-height-factor: 1.45 / 1.33;
}

// `.export-btn` (e `.export-btn-sm`): fonte de formulário (Arial).
component EBtn {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> small;
    in property <bool> active;
    in property <string> hint;
    in property <length> fixed-w;
    in property <length> font-size: root.small ? 11px : 12px;
    in property <bool> bold;
    callback clicked();
    height: root.small ? 24px : 29.3px;
    width: root.fixed-w > 0 ? root.fixed-w : lbl.preferred-width + (root.small ? 22px : 32px) + 2px;
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: root.primary ? Theme.success : root.active ? Theme.success : Theme.border-2;
        background: root.primary ? (ta.has-hover && root.enabled ? Theme.success.brighter(8%) : Theme.success)
            : root.active ? Theme.accent-bg
            : (ta.has-hover && root.enabled ? Theme.panel-3 : Theme.panel-2);
        animate background, border-color { duration: 120ms; }
    }
    lbl := Text {
        text: root.text;
        font-family: Form.control-font;
        font-size: root.font-size;
        font-weight: root.bold ? 700 : 400;
        letter-spacing: root.bold ? 0.3px : 0;
        color: root.primary ? white : root.active ? Theme.success : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    @children
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
    HintTrigger {
        hovered: ta.has-hover;
        hint: root.hint;
        layer: ExL.layer;
    }
}

// Botão só de ícone (`.export-icon-btn`): 28 px de largura, ícone de 13 px.
component EIconBtn inherits EBtn {
    small: true;
    fixed-w: 28px;
    height: 24.3px;
}

// `.export-zoom-btn`: 26 px, glifo de 14 px.
component EZoomBtn inherits EBtn {
    small: true;
    fixed-w: 26px;
    height: 23.3px;
    font-size: 14px;
}

// `.export-check`: pílula com a caixa nativa de 13 px.
component EChk {
    in property <string> text;
    in property <bool> checked;
    in property <bool> disabled;
    // Sem o realce de marcada (as caixas soltas da web não ganham `.checked`).
    in property <bool> plain;
    callback toggled();
    height: 30.1px;
    width: lbl.preferred-width + 13px + 6px + 20px + 2px;
    opacity: root.disabled ? 0.4 : 1;
    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: root.checked && !root.plain ? Theme.success : (ta.has-hover && !root.disabled ? Theme.text-3 : Theme.border-2);
        background: root.checked && !root.plain ? Theme.accent-bg : Theme.panel-2;
        animate border-color, background { duration: 120ms; }
    }
    CheckBox {
        x: 11px;
        y: (parent.height - 13px) / 2;
        size: 13px;
        checked: root.checked;
        disabled: root.disabled;
    }
    lbl := Text {
        x: 11px + 13px + 6px;
        text: root.text;
        font-size: 12px;
        color: Theme.text;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: root.disabled ? not-allowed : pointer;
        clicked => {
            if !root.disabled {
                root.toggled();
            }
        }
    }
}

// `.export-input` (texto): 12 px Arial, raio 7, borda verde no foco.
component EInput {
    in-out property <string> text;
    in property <TextHorizontalAlignment> align: left;
    in property <bool> invalid;
    in property <bool> enabled: true;
    callback edited(string);
    callback committed(string);
    callback arrow(int);
    height: 29.3px;
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: root.invalid ? Theme.danger-2 : input.has-focus ? Theme.success : Theme.border-2;
        background: Theme.panel-2;
        animate border-color { duration: 120ms; }
    }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        text <=> root.text;
        enabled: root.enabled;
        font-family: Form.control-font;
        font-size: 12px;
        color: Theme.text;
        single-line: true;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        selection-background-color: Theme.accent;
        edited => { root.edited(self.text); }
        accepted => { root.committed(self.text); }
        changed has-focus => {
            if !self.has-focus {
                root.committed(self.text);
            }
        }
        key-pressed(e) => {
            if e.text == Key.UpArrow {
                root.arrow(1);
                return accept;
            }
            if e.text == Key.DownArrow {
                root.arrow(-1);
                return accept;
            }
            reject
        }
    }
}

// `select.export-input`: caixa com a seta cinza de 10×6 a 9 px da direita e a
// lista que abre por cima (o popup nativo do `<select>`).
component ESelect {
    in property <[SelOpt]> options;
    in property <int> index;
    in property <bool> enabled: true;
    callback selected(int);
    height: 28.7px;
    min-width: 60px;
    opacity: root.enabled ? 1 : 0.45;
    // A lista é a camada `SelectLayer` (ver select_layer.slint).
    property <int> uid;
    init => {
        root.uid = SelPop.next-id;
        SelPop.next-id += 1;
    }
    property <bool> pop-open: SelPop.open && SelPop.owner == root.uid;
    property <int> seq: SelPop.result-seq;
    changed seq => {
        if SelPop.owner == root.uid {
            root.selected(SelPop.result);
        }
    }
    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: root.pop-open ? Theme.success : Theme.border-2;
        background: Theme.panel-2;
    }
    Text {
        x: 10px;
        width: parent.width - 10px - 27px;
        text: root.index >= 0 && root.index < root.options.length ? root.options[root.index].text : "";
        font-family: Form.control-font;
        font-size: 12px;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    Path {
        x: parent.width - 9px - 10px;
        y: (parent.height - 6px) / 2;
        width: 10px;
        height: 6px;
        viewbox-width: 10;
        viewbox-height: 6;
        fill: #a1a1aa;
        commands: "M0 0L5 6L10 0Z";
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => {
            if root.enabled {
                SelPop.show(root.uid, root.options, root.index, self.absolute-position.x, self.absolute-position.y + root.height + 1px,
                    root.width, root.height, 1);
            }
        }
    }
}

// `<input type="range">` nativo com `accent-color`: trilha de 8 px com
// contorno, parte cheia na cor de destaque até o centro do botão de 16 px.
component ERange {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> value;
    in property <bool> enabled: true;
    callback changed-value(int);
    height: 16px;
    property <float> ratio: root.maximum > root.minimum ? (root.value - root.minimum) / (root.maximum - root.minimum) : 0;
    property <length> knob-x: 8px + root.ratio * (root.width - 16px);
    Rectangle {
        y: 4px;
        height: 8px;
        border-radius: 4px;
        border-width: 0.67px;
        border-color: Theme.dark ? #858585 : #767676;
        background: Theme.dark ? #3b3b3b : #efefef;
    }
    Rectangle {
        x: 0;
        y: 4px;
        width: root.knob-x;
        height: 8px;
        border-radius: 4px;
        border-width: 0.67px;
        border-color: Theme.dark ? #858585 : #767676;
        background: Theme.success;
    }
    Rectangle {
        x: root.knob-x - 8px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.success;
    }
    function value-at(x: length) -> int {
        return max(root.minimum, min(root.maximum,
            root.minimum + round((x - 8px) / max(1px, root.width - 16px) * (root.maximum - root.minimum))));
    }
    TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.changed-value(root.value-at(self.mouse-x));
            }
        }
        moved => {
            if self.pressed {
                root.changed-value(root.value-at(self.mouse-x));
            }
        }
    }
}

// Linha de pílulas que quebra (o `flex-wrap` da web, já quebrado no Rust).
component ChkRows {
    in property <[ExRow]> rows;
    callback toggled(int);
    VerticalLayout {
        spacing: 6px;
        for row in root.rows: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for c in row.items: EChk {
                text: c.text;
                checked: c.checked;
                disabled: c.disabled;
                toggled => { root.toggled(c.idx); }
            }
        }
    }
}

// Grupo de zoom (`.export-zoom`): −, nível, +.
component ZoomGroup inherits HorizontalLayout {
    in property <string> level;
    callback zoom-out();
    callback zoom-in();
    spacing: 4px;
    padding-left: 4px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        EZoomBtn {
            text: "−";
            hint: T.s("export.zoomOut");
            clicked => { root.zoom-out(); }
        }
    }
    Text {
        min-width: 34px;
        text: root.level;
        font-size: 11px;
        color: Theme.text-2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        EZoomBtn {
            text: "+";
            hint: T.s("export.zoomIn");
            clicked => { root.zoom-in(); }
        }
    }
}

// Alça do recorte: área de 18 px, desenho de 8 px do lado de FORA da moldura.
// `dx`/`dy` = onde o desenho fica dentro da área.
component CropHandle {
    in property <string> dir;
    in property <length> dx;
    in property <length> dy;
    in property <MouseCursor> cursor;
    if root.dir != "move": Rectangle {
        x: root.dx;
        y: root.dy;
        width: 8px;
        height: 8px;
        Rectangle {
            x: -1px;
            y: -1px;
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: ta.has-hover || Ex.cropping ? Theme.success : rgba(0, 0, 0, 0.55);
        }
        Rectangle {
            border-radius: 2px;
            background: ta.has-hover || Ex.cropping ? Theme.success : white;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.cursor;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                if e.button == PointerEventButton.middle || (e.button == PointerEventButton.left && e.modifiers.shift) {
                    Ex.pan-down(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    self.panning = true;
                } else if e.button == PointerEventButton.left {
                    Ex.crop-down(root.dir, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            if e.kind == PointerEventKind.up {
                if self.panning {
                    self.panning = false;
                    Ex.pan-up();
                } else {
                    Ex.crop-up();
                }
            }
        }
        property <bool> panning;
        moved => {
            if self.pressed {
                if self.panning {
                    Ex.pan-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                } else {
                    Ex.crop-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

// Palco da prévia (`.export-preview-video` + `.export-frame`).
component Stage {
    in property <length> frame-w;
    in property <length> frame-h;
    callback stage-click();
    // Folga das alças (14 px) + borda.
    property <length> g: 15px;
    width: root.frame-w + 2 * root.g;
    height: root.frame-h + 2 * root.g;
    // Quadro com o zoom (origem no centro) e o deslocamento.
    property <length> zx: root.g + root.frame-w / 2 * (1 - Ex.zoom) + Ex.pan-x;
    property <length> zy: root.g + root.frame-h / 2 * (1 - Ex.zoom) + Ex.pan-y;
    property <length> zw: root.frame-w * Ex.zoom;
    property <length> zh: root.frame-h * Ex.zoom;
    // Moldura do recorte, na tela.
    property <length> bx: root.zx + Ex.crop-l * root.zw;
    property <length> by: root.zy + Ex.crop-t * root.zh;
    property <length> bw: Ex.crop-w * root.zw;
    property <length> bh: Ex.crop-h * root.zh;
    property <bool> label-inside: root.by < 22px;

    changed frame-w => { Ex.frame-resized(root.frame-w, root.frame-h); }
    changed frame-h => { Ex.frame-resized(root.frame-w, root.frame-h); }
    init => { Ex.frame-resized(root.frame-w, root.frame-h); }

    Rectangle {
        background: black;
        border-radius: Ex.crop-on ? 0 : 8px;
        clip: true;
        stage-ta := TouchArea {
            mouse-cursor: Ex.panning ? grabbing : Ex.zoom > 1.001 ? grab : pointer;
            property <bool> panning;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    if (e.button == PointerEventButton.left || e.button == PointerEventButton.middle) && Ex.zoom > 1.001 {
                        self.panning = true;
                        Ex.pan-down(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                if e.kind == PointerEventKind.up && self.panning {
                    self.panning = false;
                    Ex.pan-up();
                }
            }
            moved => {
                if self.pressed && self.panning {
                    Ex.pan-move(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            clicked => { root.stage-click(); }
            scroll-event(e) => {
                if e.modifiers.control && e.delta-y != 0 {
                    Ex.stage-wheel(self.mouse-x - self.width / 2, self.mouse-y - self.height / 2, e.delta-y / 1px);
                    return accept;
                }
                reject
            }

            Image {
                x: root.g + Ex.frame-x;
                y: root.g + Ex.frame-y;
                width: Ex.frame-w;
                height: Ex.frame-h;
                source: Ex.frame;
                image-fit: fill;
                opacity: Ex.audio-only ? 0.22 : 1;
            }

            if Ex.crop-on && !Ex.audio-only: Rectangle {
                // Sombra do que fica FORA do recorte (quatro faixas).
                Rectangle {
                    x: root.zx;
                    y: root.zy;
                    width: root.zw;
                    height: max(0px, root.by - root.zy);
                    background: rgba(0, 0, 0, 0.55);
                }
                Rectangle {
                    x: root.zx;
                    y: root.by + root.bh;
                    width: root.zw;
                    height: max(0px, root.zy + root.zh - root.by - root.bh);
                    background: rgba(0, 0, 0, 0.55);
                }
                Rectangle {
                    x: root.zx;
                    y: root.by;
                    width: max(0px, root.bx - root.zx);
                    height: root.bh;
                    background: rgba(0, 0, 0, 0.55);
                }
                Rectangle {
                    x: root.bx + root.bw;
                    y: root.by;
                    width: max(0px, root.zx + root.zw - root.bx - root.bw);
                    height: root.bh;
                    background: rgba(0, 0, 0, 0.55);
                }
                // Moldura: contorno escuro por fora, branco por dentro, terços.
                Rectangle {
                    x: root.bx - 1px;
                    y: root.by - 1px;
                    width: root.bw + 2px;
                    height: root.bh + 2px;
                    border-width: 1px;
                    border-color: rgba(0, 0, 0, 0.55);
                }
                Rectangle {
                    x: root.bx;
                    y: root.by;
                    width: root.bw;
                    height: root.bh;
                    border-width: 1px;
                    border-color: Ex.cropping ? Theme.success : rgba(255, 255, 255, 0.9);
                    Rectangle { x: parent.width / 3 - 0.5px; width: 1px; background: rgba(255, 255, 255, 0.9); opacity: 0.35; }
                    Rectangle { x: parent.width * 2 / 3 - 0.5px; width: 1px; background: rgba(255, 255, 255, 0.9); opacity: 0.35; }
                    Rectangle { y: parent.height / 3 - 0.5px; height: 1px; background: rgba(255, 255, 255, 0.9); opacity: 0.35; }
                    Rectangle { y: parent.height * 2 / 3 - 0.5px; height: 1px; background: rgba(255, 255, 255, 0.9); opacity: 0.35; }
                    // Arrastar o miolo move a moldura (clique parado toca/pausa).
                    CropHandle {
                        dir: "move";
                        cursor: move;
                        dx: -100px;
                        dy: -100px;
                    }
                }
                // Medida: acima da moldura; colada no topo, desce pra dentro.
                if !root.label-inside: Text {
                    x: root.bx;
                    y: root.by - 3px - self.preferred-height;
                    text: Ex.crop-size;
                    font-size: 13px;
                    color: Theme.text;
                }
                if root.label-inside: Rectangle {
                    x: root.bx;
                    y: root.by + 3px;
                    width: sz.preferred-width + 12px;
                    height: sz.preferred-height + 4px;
                    border-radius: 4px;
                    background: rgba(0, 0, 0, 0.75);
                    sz := Text {
                        text: Ex.crop-size;
                        font-size: 11px;
                        color: white;
                    }
                }
                // Alças: bordas primeiro, cantos por cima.
                if Ex.edges-h: CropHandle {
                    x: root.bx + 18px;
                    y: root.by - 9px;
                    width: max(0px, root.bw - 36px);
                    height: 18px;
                    dir: "n";
                    cursor: ns-resize;
                    dx: self.width / 2 - 4px;
                    dy: 1px;
                }
                if Ex.edges-h: CropHandle {
                    x: root.bx + 18px;
                    y: root.by + root.bh - 9px;
                    width: max(0px, root.bw - 36px);
                    height: 18px;
                    dir: "s";
                    cursor: ns-resize;
                    dx: self.width / 2 - 4px;
                    dy: 9px;
                }
                if Ex.edges-v: CropHandle {
                    x: root.bx - 9px;
                    y: root.by + 18px;
                    width: 18px;
                    height: max(0px, root.bh - 36px);
                    dir: "w";
                    cursor: ew-resize;
                    dx: 1px;
                    dy: self.height / 2 - 4px;
                }
                if Ex.edges-v: CropHandle {
                    x: root.bx + root.bw - 9px;
                    y: root.by + 18px;
                    width: 18px;
                    height: max(0px, root.bh - 36px);
                    dir: "e";
                    cursor: ew-resize;
                    dx: 9px;
                    dy: self.height / 2 - 4px;
                }
                CropHandle {
                    x: root.bx - 9px;
                    y: root.by - 9px;
                    width: 18px;
                    height: 18px;
                    dir: "nw";
                    cursor: nwse-resize;
                    dx: 1px;
                    dy: 1px;
                }
                CropHandle {
                    x: root.bx + root.bw - 9px;
                    y: root.by - 9px;
                    width: 18px;
                    height: 18px;
                    dir: "ne";
                    cursor: nesw-resize;
                    dx: 9px;
                    dy: 1px;
                }
                CropHandle {
                    x: root.bx - 9px;
                    y: root.by + root.bh - 9px;
                    width: 18px;
                    height: 18px;
                    dir: "sw";
                    cursor: nesw-resize;
                    dx: 1px;
                    dy: 9px;
                }
                CropHandle {
                    x: root.bx + root.bw - 9px;
                    y: root.by + root.bh - 9px;
                    width: 18px;
                    height: 18px;
                    dir: "se";
                    cursor: nwse-resize;
                    dx: 9px;
                    dy: 9px;
                }
            }
        }

        // Legenda (CC): fora do zoom, proporcional ao quadro.
        if Ex.caption != "" && !Ex.audio-only: Rectangle {
            width: Ex.caption-w;
            height: cap.preferred-height;
            x: (parent.width - self.width) / 2;
            y: parent.height - root.g - root.frame-h * 0.06 - self.height;
            cap := Text {
                width: parent.width;
                text: Ex.caption;
                font-size: Ex.caption-font;
                font-weight: 700;
                color: white;
                stroke: rgba(0, 0, 0, 0.9);
                stroke-width: max(1.5px, Ex.caption-font * 0.12);
                stroke-style: outside;
                wrap: word-wrap;
                horizontal-alignment: center;
                line-height-factor: 1.33 / 1.33;
            }
        }

        if Ex.audio-only: Text {
            text: T.s("export.audioOnlyBadge");
            font-size: 13px;
            font-weight: 600;
            color: white;
            stroke: rgba(0, 0, 0, 0.6);
            stroke-width: 1px;
            stroke-style: outside;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if !Ex.ready: Rectangle {
            background: Theme.panel-2;
            Text {
                x: 12px;
                width: parent.width - 24px;
                text: Ex.msg;
                font-size: 12px;
                color: Theme.text-3;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
    Rectangle {
        border-radius: Ex.crop-on ? 0 : 8px;
        border-width: 1px;
        border-color: Theme.border-2;
    }
}

// Linha do tempo (`.export-timeline-scroll`): trechos + onda (imagem do Rust),
// divisões, cursor, régua e a barra de rolagem fina.
component Timeline {
    property <length> view: root.width - 2px;
    changed view => { Ex.tl-view(root.view); }
    init => { Ex.tl-view(root.view); }
    height: 2px + 46px + 17px + 8px;
    Rectangle {
        border-radius: 7px;
        background: Theme.panel-2;
        clip: true;
        TouchArea {
            scroll-event(e) => {
                if e.delta-y != 0 {
                    Ex.tl-wheel(self.mouse-x - 1px, e.delta-y / 1px);
                }
                accept
            }
        }
        Image {
            x: 1px;
            y: 1px;
            width: root.view;
            height: 46px;
            source: Ex.tl-img;
            image-fit: fill;
        }
        if !Ex.has-wave: Rectangle {
            x: 1px;
            y: 1px;
            width: root.view;
            height: 46px;
            clip: true;
            for l in Ex.part-labels: Text {
                x: l.x;
                width: l.w;
                text: l.text;
                font-size: 10px;
                color: Theme.text-2;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: clip;
            }
        }
        Rectangle {
            x: 1px;
            y: 1px;
            width: root.view;
            height: 46px;
            clip: true;
            for c in Ex.cuts: Rectangle {
                x: c.x - 2.5px;
                width: 5px;
                Rectangle {
                    background: rgba(0, 0, 0, 0.55);
                }
                Rectangle {
                    x: 1px;
                    width: 3px;
                    background: c.target ? Theme.danger-2 : Theme.accent-2;
                }
                Path {
                    x: -1.5px;
                    y: 0;
                    width: 8px;
                    height: 5px;
                    viewbox-width: 8;
                    viewbox-height: 5;
                    fill: c.target ? Theme.danger-2 : Theme.accent-2;
                    commands: "M0 0L8 0L4 5Z";
                }
                Path {
                    x: -1.5px;
                    y: parent.height - 5px;
                    width: 8px;
                    height: 5px;
                    viewbox-width: 8;
                    viewbox-height: 5;
                    fill: c.target ? Theme.danger-2 : Theme.accent-2;
                    commands: "M0 5L8 5L4 0Z";
                }
            }
            Rectangle {
                x: Ex.playhead-x - 2px;
                width: 4px;
                background: rgba(0, 0, 0, 0.5);
                Rectangle {
                    x: 1px;
                    width: 2px;
                    background: Theme.text;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        Ex.tl-seek(self.mouse-x);
                    }
                }
                moved => {
                    if self.pressed {
                        Ex.tl-seek(self.mouse-x);
                    }
                }
                scroll-event(e) => {
                    if e.delta-y != 0 {
                        Ex.tl-wheel(self.mouse-x, e.delta-y / 1px);
                    }
                    accept
                }
            }
        }
        // Régua.
        Rectangle {
            x: 1px;
            y: 1px + 46px;
            width: root.view;
            height: 17px;
            background: Theme.panel;
            clip: true;
            for t in Ex.ticks: Rectangle {
                x: t.x;
                width: 60px;
                Rectangle {
                    x: 0;
                    width: 1px;
                    background: Theme.border-2;
                }
                Text {
                    x: 4px;
                    text: t.text;
                    font-size: 9px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border-2;
            }
        }
        // Barra de rolagem (8 px, polegar `--border-2`).
        Rectangle {
            x: 1px;
            y: 1px + 46px + 17px;
            width: root.view;
            height: 8px;
            Rectangle {
                x: Ex.sb-x;
                width: Ex.sb-w;
                border-radius: 4px;
                background: sbta.has-hover || sbta.pressed ? Theme.text-3 : Theme.border-2;
                sbta := TouchArea {
                    property <length> start-x;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            self.start-x = Ex.sb-x;
                        }
                    }
                    moved => {
                        if self.pressed {
                            Ex.tl-scroll(self.start-x + self.mouse-x - self.pressed-x);
                        }
                    }
                }
            }
        }
    }
    Rectangle {
        border-radius: 7px;
        border-width: 1px;
        border-color: Theme.border-2;
    }
}

// Rótulo de coluna (`.export-col label`): rótulo comum, 13 px.
component ColLabel inherits Text {
    height: 18.2px;
    font-size: 13px;
    color: Theme.text;
    vertical-alignment: center;
}

export component ExportScreen {
    visible: self.opacity > 0;
    opacity: Ex.open ? 1 : 0;
    animate opacity { duration: 160ms; easing: ease; }

    Rectangle {
        background: Theme.bg;
    }
    TouchArea { }

    fs := FocusScope {
        key-pressed(e) => {
            if Ex.key(e.text, e.modifiers.control) {
                return accept;
            }
            reject
        }
    }
    changed visible => {
        if self.visible {
            fs.focus();
        }
    }

    // ---- cabeçalho (`.export-header`) ----
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 49px;
        background: Theme.panel;
        Rectangle {
            x: 18px;
            y: 10px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: bta.has-hover ? Theme.panel-3 : transparent;
            animate background { duration: 120ms; }
            StrokeIcon {
                size: 18px;
                commands: "M19 12H5 M12 19L5 12L12 5";
                stroke: bta.has-hover ? Theme.text : Theme.text-2;
            }
            bta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Ex.close(); }
            }
            HintTrigger {
                hovered: bta.has-hover;
                hint: T.s("settings.buttons.back");
                layer: ExL.layer;
            }
        }
        Text {
            x: 56px;
            text: T.s("export.title");
            font-size: 14px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.border;
        }
    }

    // ---- corpo: coluna de até 880 px, centrada ----
    property <length> body-h: root.height - 49px;
    // O formulário é mais alto que a janela em qualquer tamanho útil: a barra
    // de rolagem (8 px) fica sempre descontada, como na web. Medir a altura
    // do conteúdo aqui seria laço (a largura da coluna decide a altura).
    property <length> avail: root.width - 8px;
    property <length> col-w: min(880px, root.avail) - 36px;
    property <length> col-x: (root.avail - min(880px, root.avail)) / 2 + 18px;
    // Palco: o teto de ALTURA vira teto de LARGURA (`_syncStageAspect`).
    property <length> max-stage-h: min(Main.win-h * 0.58, 560px);
    property <length> stage-w: min(root.col-w, round((root.max-stage-h * Ex.aspect + 28px) / 1px) * 1px);
    property <length> frame-w: root.stage-w - 30px;
    property <length> frame-h: root.frame-w / max(0.01, Ex.aspect);

    body := ScrollArea {
        x: 0;
        y: 49px;
        width: root.width;
        height: root.body-h;
        // Pela posição do último item: o `preferred-height` do layout fica
        // aquém da soma real (cortava os botões do fim).
        content-h: max(content.preferred-height, end-mark.y) + 36px;
        content := VerticalLayout {
            x: root.col-x;
            y: 18px;
            width: root.col-w;
            // Altura própria, não a da área rolável (senão o layout estica).
            height: self.preferred-height;
            alignment: start;

            // ---- telas ----
            FLabel { text: T.s("export.regions"); }
            Rectangle { height: 7px; }
            ChkRows {
                rows: Ex.region-rows;
                toggled(i) => { Ex.region(i); }
            }
            Rectangle { height: 6px; }
            FHint { text: T.s("export.regionsHint"); }

            // ---- trechos ----
            Rectangle { height: 16px; }
            FLabel { text: T.s("export.range"); }
            Rectangle { height: 7px; }
            HorizontalLayout {
                alignment: center;
                Stage {
                    frame-w: root.frame-w;
                    frame-h: root.frame-h;
                    stage-click => { Ex.stage-click(); }
                }
            }
            if Ex.crop-on: VerticalLayout {
                Rectangle { height: 7px; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    height: 24px;
                    EBtn {
                        small: true;
                        text: T.s("export.cropReset");
                        enabled: Ex.crop-reset-enabled;
                        clicked => { Ex.crop-reset(); }
                    }
                    ZoomGroup {
                        level: Ex.zoom-badge;
                        zoom-out => { Ex.crop-zoom(1 / 1.4); }
                        zoom-in => { Ex.crop-zoom(1.4); }
                    }
                    EBtn {
                        small: true;
                        text: T.s("export.zoomReset");
                        enabled: Ex.zoom-reset-enabled;
                        clicked => { Ex.crop-zoom-reset(); }
                    }
                    Text {
                        text: Ex.crop-info;
                        font-size: 11px;
                        color: Theme.text-3;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle { height: 6px; }
                FHint { text: T.s("export.cropHint"); }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                spacing: 10px;
                height: 24.3px;
                EIconBtn {
                    enabled: Ex.play-enabled;
                    hint: Ex.playing ? T.s("export.pause") : T.s("export.play");
                    clicked => { Ex.toggle-play(); }
                    if !Ex.playing: FillIcon {
                        x: (parent.width - 13px) / 2;
                        y: (parent.height - 13px) / 2;
                        commands: "M8 5v14l11-7z";
                        fill: Theme.text;
                    }
                    if Ex.playing: FillIcon {
                        x: (parent.width - 13px) / 2;
                        y: (parent.height - 13px) / 2;
                        commands: "M6 5h4v14H6zm8 0h4v14h-4z";
                        fill: Theme.text;
                    }
                }
                EIconBtn {
                    enabled: Ex.play-enabled;
                    hint: Ex.muted ? T.s("export.unmute") : T.s("export.mute");
                    clicked => { Ex.toggle-mute(); }
                    FillIcon {
                        x: (parent.width - 13px) / 2;
                        y: (parent.height - 13px) / 2;
                        commands: "M4 9L8 9L13 5L13 19L8 15L4 15Z";
                        fill: Theme.text;
                    }
                    StrokeIcon {
                        x: (parent.width - 13px) / 2;
                        y: (parent.height - 13px) / 2;
                        size: 13px;
                        commands: Ex.muted ? "M17 9L22 15 M22 9L17 15" : "M16.5 8.5a5 5 0 0 1 0 7 M19 6a9 9 0 0 1 0 12";
                        stroke: Theme.text;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ERange {
                        width: 92px;
                        minimum: 0;
                        maximum: 100;
                        value: Ex.volume;
                        changed-value(v) => { Ex.volume-changed(v); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    EIconBtn {
                        height: 22.7px;
                        text: "CC";
                        font-size: 10px;
                        bold: true;
                        enabled: Ex.cc-enabled;
                        active: Ex.cc-active;
                        hint: Ex.cc-hint;
                        clicked => { Ex.toggle-cc(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: T.s("export.playHint");
                    font-size: 11px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
            }
            Rectangle { height: 10px; }
            Timeline { }
            Rectangle { height: 9px; }
            HorizontalLayout {
                spacing: 10px;
                height: 29.3px;
                VerticalLayout {
                    alignment: center;
                    EBtn {
                        small: true;
                        text: T.s("export.cutHere");
                        enabled: Ex.cut-enabled;
                        clicked => { Ex.cut(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    EBtn {
                        small: true;
                        text: T.s("export.removeCut");
                        enabled: Ex.uncut-enabled;
                        hint: Ex.uncut-hint;
                        clicked => { Ex.uncut(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    EBtn {
                        small: true;
                        text: Ex.toggle-text;
                        enabled: Ex.toggle-enabled;
                        clicked => { Ex.toggle-part(); }
                    }
                }
                ZoomGroup {
                    level: Ex.tl-zoom-text;
                    zoom-out => { Ex.tl-zoom(1 / 1.6); }
                    zoom-in => { Ex.tl-zoom(1.6); }
                }
                EInput {
                    width: 74px;
                    align: center;
                    text <=> Ex.time-text;
                    committed(t) => { Ex.time-commit(t); }
                }
                Text {
                    text: "/";
                    font-size: 11px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
                Text {
                    text: Ex.total-text;
                    font-size: 11px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: Ex.range-text;
                    font-size: 11px;
                    color: Theme.text-2;
                    vertical-alignment: center;
                }
            }
            Rectangle { height: 6px; }
            FHint { text: T.s("export.rangeHint"); }

            // ---- áudio ----
            if Ex.audio-visible: VerticalLayout {
                Rectangle { height: 16px; }
                FLabel { text: T.s("export.audio"); }
                Rectangle { height: 7px; }
                if Ex.orig-visible: HorizontalLayout {
                    alignment: start;
                    EChk {
                        text: T.s("export.originalAudio");
                        plain: true;
                        checked: Ex.orig-checked;
                        toggled => { Ex.orig(!Ex.orig-checked); }
                    }
                }
                if Ex.orig-visible: Rectangle { height: 7px; }
                ChkRows {
                    rows: Ex.track-rows;
                    toggled(i) => { Ex.track(i); }
                }
                Rectangle { height: 7px; }
                HorizontalLayout {
                    alignment: start;
                    EChk {
                        text: T.s("export.mixAudio");
                        plain: true;
                        checked: Ex.mix-checked;
                        disabled: !Ex.mix-enabled;
                        toggled => { Ex.mix(!Ex.mix-checked); }
                    }
                }
            }

            // ---- resolução + codificador ----
            Rectangle { height: 16px; }
            VerticalLayout {
                opacity: Ex.video-off ? 0.45 : 1;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        width: (root.col-w - 10px) / 2;
                        ColLabel { text: T.s("export.resolution"); }
                        ESelect {
                            options: Ex.res-opts;
                            index: Ex.res-idx;
                            enabled: !Ex.video-off;
                            selected(i) => { Ex.res(i); }
                        }
                    }
                    VerticalLayout {
                        width: (root.col-w - 10px) / 2;
                        ColLabel { text: T.s("export.encoder"); }
                        ESelect {
                            options: Ex.enc-opts;
                            index: Ex.enc-idx;
                            enabled: !Ex.video-off;
                            selected(i) => { Ex.enc(i); }
                        }
                    }
                }
                Rectangle { height: 6px; }
                FHint { text: T.s("export.resolutionHint"); }
            }

            // ---- redimensionamento ----
            if Ex.scale-visible: VerticalLayout {
                opacity: Ex.video-off ? 0.45 : 1;
                Rectangle { height: 16px; }
                FLabel { text: T.s("export.scale"); }
                Rectangle { height: 7px; }
                ESelect {
                    options: Ex.scale-opts;
                    index: Ex.scale-idx;
                    enabled: !Ex.video-off;
                    selected(i) => { Ex.scale(i); }
                }
                Rectangle { height: 6px; }
                FHint { text: Ex.scale-hint; }
            }

            // ---- velocidade ----
            Rectangle { height: 16px; }
            FLabel { text: T.s("export.speed"); }
            Rectangle { height: 7px; }
            HorizontalLayout {
                spacing: 10px;
                height: 29.3px;
                EInput {
                    width: 74px;
                    align: right;
                    invalid: Ex.speed-invalid;
                    text <=> Ex.speed-text;
                    edited(t) => { Ex.speed-edit(t); }
                    committed(t) => { Ex.speed-commit(t); }
                    arrow(d) => { Ex.speed-step(d); }
                }
                Text {
                    text: "×";
                    font-size: 13px;
                    color: Theme.text-2;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: Ex.speed-value;
                    font-size: 11px;
                    color: Theme.text-2;
                    vertical-alignment: center;
                }
            }
            Rectangle { height: 6px; }
            FHint { text: T.s("export.speedHint"); }

            // ---- quadros por segundo ----
            if Ex.fps-visible: VerticalLayout {
                opacity: Ex.video-off ? 0.45 : 1;
                Rectangle { height: 16px; }
                FLabel { text: T.s("export.fps"); }
                Rectangle { height: 7px; }
                HorizontalLayout {
                    spacing: 10px;
                    ERange {
                        horizontal-stretch: 1;
                        minimum: Ex.fps-min;
                        maximum: Ex.fps-max;
                        value: Ex.fps-val;
                        enabled: !Ex.video-off;
                        changed-value(v) => { Ex.fps(v); }
                    }
                    Text {
                        text: Ex.fps-text;
                        font-size: 11px;
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 6px; }
                FHint { text: T.s("export.fpsHint"); }
            }

            // ---- qualidade ----
            Rectangle { height: 16px; }
            VerticalLayout {
                opacity: Ex.video-off ? 0.45 : 1;
                FLabel { text: T.s("export.quality"); }
                Rectangle { height: 7px; }
                HorizontalLayout {
                    spacing: 10px;
                    ERange {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 51;
                        value: Ex.q-pos;
                        enabled: !Ex.video-off;
                        changed-value(v) => { Ex.quality(v); }
                    }
                    Text {
                        text: Ex.q-text;
                        font-size: 11px;
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 6px; }
                FHint {
                    text: Ex.q-hint;
                    color: Ex.q-warn ? #f59e0b : Theme.text-3;
                }
            }

            // ---- legenda gravada ----
            Rectangle { height: 16px; }
            VerticalLayout {
                opacity: Ex.video-off ? 0.45 : 1;
                FLabel { text: T.s("export.captions"); }
                Rectangle { height: 7px; }
                HorizontalLayout {
                    alignment: start;
                    EChk {
                        text: T.s("export.burnCaptions");
                        checked: Ex.burn-checked;
                        disabled: !Ex.burn-enabled;
                        toggled => { Ex.burn(!Ex.burn-checked); }
                    }
                }
                Rectangle { height: 6px; }
                FHint { text: Ex.cap-hint; }
            }

            // ---- nome + formato ----
            Rectangle { height: 16px; }
            FLabel { text: T.s("export.fileName"); }
            Rectangle { height: 7px; }
            HorizontalLayout {
                spacing: 10px;
                EInput {
                    horizontal-stretch: 1;
                    text <=> Ex.name;
                }
                VerticalLayout {
                    alignment: center;
                    ESelect {
                        width: 96px;
                        options: Ex.cont-opts;
                        index: Ex.cont-idx;
                        enabled: Ex.cont-enabled;
                        selected(i) => { Ex.cont(i); }
                    }
                }
            }
            Rectangle { height: 6px; }
            FHint { text: Ex.cont-hint; }

            // ---- ação + progresso ----
            Rectangle { height: 20px; }
            HorizontalLayout {
                spacing: 12px;
                EBtn {
                    text: Ex.run-text;
                    primary: !Ex.running;
                    enabled: Ex.run-enabled;
                    clicked => { Ex.run(); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    horizontal-stretch: 0;
                    EBtn {
                        text: Ex.prev-text;
                        enabled: Ex.prev-enabled;
                        hint: T.s("export.preview.hint");
                        clicked => { Ex.preview(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        ESelect {
                            width: 76px;
                            options: [{ text: "5 s", enabled: true }, { text: "10 s", enabled: true }, { text: "30 s", enabled: true }];
                            index: Ex.prevsec-idx;
                            enabled: Ex.prevsec-enabled;
                            selected(i) => { Ex.prevsec(i); }
                        }
                    }
                }
                if !Ex.running: Rectangle { horizontal-stretch: 1; }
                if Ex.running: VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.border-2;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * Ex.progress;
                            border-radius: 3px;
                            background: Theme.success;
                            animate width { duration: 220ms; }
                        }
                    }
                    Rectangle { height: 4px; }
                    Text {
                        text: Ex.progress-text;
                        font-size: 11px;
                        color: Theme.text-2;
                    }
                }
            }
            end-mark := Rectangle { height: 0; }
        }
    }
    changed scroll-top-seq => { body.set-scroll(0); }
    property <int> scroll-top-seq: Ex.scroll-top-seq;
}
