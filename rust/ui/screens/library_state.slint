// Estado da biblioteca de gravações (`recordings.js` + `folders.js` da versão
// web). Quem preenche é o `src/app_library.rs`: a lista já chega agrupada por
// período, filtrada pela busca e com a seleção marcada — a `.slint` só desenha
// e devolve os gestos.

// Um card de gravação (`.rec-card`).
export struct RecCard {
    id: string,
    name: string,
    // Data completa (`dd/mm/aaaa hh:mm:ss`), a dica do card.
    hint: string,
    size-text: string,
    // `mm:ss` / `hh:mm:ss`; vazio = duração ainda desconhecida.
    duration-text: string,
    has-thumb: bool,
    thumb: image,
    // Selos: vazio = desconhecido.
    codec: string,
    codec-hw: bool,
    codec-hint: string,
    fps-text: string,
    fps-hint: string,
    quality-text: string,
    quality-hint: string,
    // 0 = não transcrita, 1 = transcrita, 2 = transcrita sem fala.
    transcript: int,
    selected: bool,
    // Posição na seleção (1, 2, …; a ordem da união). 0 = não selecionado.
    order: int,
    order-hint: string,
    // Recortado esperando um "Colar".
    cut: bool,
}

// Um grupo de período ("Hoje", "Ontem", "Outubro 2026"…).
export struct RecGroup {
    key: string,
    label: string,
    // Linhas de cards dos grupos ANTERIORES (a posição sai daí: a altura de
    // uma linha depende da largura, que só a `.slint` sabe).
    rows-before: int,
    // 0 = nenhum selecionado, 1 = alguns, 2 = todos.
    check: int,
    items: [RecCard],
}

// Card de pasta (`.rec-folder`); `up` = o ".." de voltar.
export struct FolderCard {
    id: string,
    name: string,
    meta: string,
    hint: string,
    up: bool,
    cut: bool,
}

// Um pedaço do caminho (`.path-crumb`).
export struct PathCrumb {
    id: string,
    label: string,
    hint: string,
    current: bool,
}

// Item do menu de contexto; `sep` = separador.
export struct CtxItem {
    label: string,
    action: string,
    danger: bool,
    disabled: bool,
    hint: string,
    sep: bool,
}

export global Lib {
    // ---- lista ----
    in property <[FolderCard]> folders;
    in property <[RecGroup]> groups;
    in property <bool> at-root: true;
    in property <[PathCrumb]> crumbs;
    in property <string> parent-dir;
    // Busca sem resultado (`#emptyState`).
    in property <bool> empty;
    in-out property <string> search-text;
    // "N arquivos", "X usados", "Y livres" (`.meta-sep` entre eles).
    in property <[string]> meta-parts;
    in property <bool> low-disk;

    // ---- barra ----
    in property <int> sel-count;
    in property <bool> merge-busy;
    in property <bool> export-enabled;
    in property <string> delete-hint;
    in property <string> merge-hint;
    in property <string> export-hint;

    // ---- edição do nome no próprio card ----
    in property <string> editing-id;
    in property <string> editing-text;

    // ---- arrastar ----
    in property <bool> dragging;
    in property <string> drag-label;
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    // Alvo sob o cursor (id da pasta, `::trash` = botão de excluir).
    in-out property <string> drop-target;

    // ---- menu de contexto ----
    in property <bool> ctx-open;
    in property <length> ctx-x;
    in property <length> ctx-y;
    in property <[CtxItem]> ctx-items;

    // Sobe quando o Rust quer o foco do teclado na biblioteca.
    in property <int> focus-seq;

    // Colunas da grade (a `.slint` informa quando a largura muda).
    callback cols-changed(int);
    callback search(string);
    callback open-record-dir();
    callback new-folder();
    callback merge-selected();
    callback export-selected();
    callback delete-selected();
    callback card-clicked(string);
    callback toggle-select(string);
    callback group-toggle(string);
    // Botão direito: `kind` = recording / folder / empty, na posição da janela.
    callback context(string, string, length, length);
    callback ctx-run(string);
    callback ctx-close();
    callback open-folder(string);
    callback go-up();
    callback rename-recording(string);
    callback rename-commit(string, string);
    callback rename-cancel();
    callback drag-start(string);
    callback drag-end(bool);
    pure callback can-drop(string) -> bool;
    // O card ficou visível: a miniatura é decodificada sob demanda.
    callback need-thumb(string);
    // Ctrl+X, Ctrl+V, voltar (Backspace / Alt+←).
    callback key-cut();
    callback key-paste();
}
