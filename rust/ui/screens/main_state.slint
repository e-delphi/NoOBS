// Estado da tela principal. O Rust (`app_view`) escreve aqui o que o core
// conta pelo `View`; as telas só leem e chamam os callbacks, que vão direto
// pros handlers do core (sem JSON).

// Um microfone ou uma saída na coluna de fontes (`.source-item`).
export struct SourceItem {
    id: string,
    name: string,
    enabled: bool,
    is-default: bool,
    bluetooth: bool,
    // Faixa do arquivo (0 = sem faixa). A cor já vem calculada.
    track: int,
    track-color: color,
    // Medidor: 0..1 já na curva de dB da web (`ampToBar`).
    meter-l: float,
    meter-r: float,
    stereo: bool,
    muted: bool,
}

// Uma linha da legenda de faixas (`.track-legend-item`).
// kind: "default" (bolinha verde), "mix", "track", "off" (sem faixa).
export struct LegendItem {
    kind: string,
    track-label: string,
    name: string,
    hint: string,
    color: color,
}

// Um monitor ou webcam no bloco "Telas" (`.display-rect`). x/y/w/h em
// coordenadas da área de trabalho; a tela escala.
export struct DisplayItem {
    id: string,
    is-webcam: bool,
    name: string,
    enabled: bool,
    x: float,
    y: float,
    w: float,
    h: float,
    thumb: image,
    has-thumb: bool,
}

// Uma janela na grade do "Capturar..." (`.winpick-item`).
export struct WindowCard {
    id: string,
    title: string,
    // "exe · 1920×1080"
    info: string,
    thumb: image,
    has-thumb: bool,
}

// Atalho de área com retângulo salvo (botão na aba Área).
export struct SavedArea {
    index: int,
    label: string,
}

export global Main {
    // ---- fontes ----
    in property <[SourceItem]> mics;
    in property <[SourceItem]> speakers;
    in property <[LegendItem]> legend;
    in property <string> mic-count: "— / —";
    in property <string> spk-count: "— / —";
    // ---- telas ----
    in property <[DisplayItem]> displays;
    // Caixa que contém tudo (monitores + webcams à direita), na área de trabalho.
    in property <float> disp-min-x;
    in property <float> disp-min-y;
    in property <float> disp-total-w: 1;
    in property <float> disp-total-h: 1;
    in property <string> mon-count: "— / —";
    // "3840×2160" da composição marcada; vazio sem nada marcado.
    in property <string> mon-meta;
    // A composição passa do limite do encoder: o aviso ao lado da resolução.
    in property <bool> mon-meta-warn;
    in property <string> mon-meta-warn-hint;

    // ---- gravação ----
    in property <bool> recording;
    in property <bool> paused;
    in property <bool> finalizing;
    // Há algo marcado pra gravar (senão o botão fica desativado).
    in property <bool> can-record: true;
    in property <string> status-text;
    in property <string> timer-main: "00:00:00";
    in property <string> timer-ms: ".00";
    in property <string> size-text;
    // ---- avisos da coluna ----
    in property <bool> busy;
    in property <string> busy-text;
    in property <bool> audio-pending;
    in property <bool> monitor-pending;

    // ---- buffer em memória ----
    // Ligado nesta sessão (chave verde) / guardando agora (bolinha pulsando).
    in property <bool> replay-on;
    in property <bool> replay-active;
    in property <bool> replay-saving;
    in property <string> replay-status;
    in property <string> replay-save-hint;
    callback replay-toggle();
    callback replay-save();

    // ---- contagem do atraso (atalho com atraso) ----
    in property <int> countdown-sec;
    // Fração que falta (1 → 0), anda a cada quadro.
    in property <float> countdown-frac;
    // Segundos desde o último número (o "pulo" do número a cada segundo).
    in property <float> countdown-tick-age: 1;
    // Centro do botão de gravar, na janela (a onda vermelha sai dele).
    in-out property <length> rec-btn-cx;
    in-out property <length> rec-btn-cy;
    // Onda vermelha ao começar (`.record-ripple`): 0 → 1 ao longo de 1,8 s,
    // já com a curva; < 0 = parada.
    in property <float> ripple: -1;
    // Altura da janela, fora do layout (modais que se limitam a ela, sem laço).
    in-out property <length> win-h: 800px;

    // ---- "Capturar..." ----
    in property <bool> picker-open;
    in property <bool> picker-area-mode;
    // Aberto por um atalho com várias janelas: sem abas e sem atualizar.
    in property <bool> picker-matches;
    in property <string> picker-subtitle;
    // Texto do filtro (o Rust zera a cada abertura).
    in property <string> picker-search-text;
    in property <[WindowCard]> picker-items;
    in property <bool> picker-loading;
    in property <string> picker-empty-text;
    in property <bool> picker-audio-supported;
    in property <bool> picker-audio;
    in property <[SavedArea]> picker-saved-areas;
    callback picker-close();
    callback picker-refresh();
    callback picker-set-area-mode(bool);
    callback picker-search(string);
    callback picker-pick(string);
    callback picker-audio-changed(bool);
    callback picker-select-area();
    callback picker-saved-area(int);

    callback toggle-record();
    callback toggle-pause();
    callback toggle-source(string /* id */, bool /* enabled */);
    callback open-settings();
    callback open-window-picker();
}
