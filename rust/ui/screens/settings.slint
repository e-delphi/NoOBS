export component SettingsScreen {
    visible: self.opacity > 0;
    opacity: St.open ? 1 : 0;
    animate opacity { duration: 180ms; easing: ease; }

    // O modal (`--panel`) cobre a janela inteira.
    Rectangle {
        background: Theme.panel;
    }
    TouchArea { }

    fs := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                St.close();
                return accept;
            }
            reject
        }
    }
    changed visible => {
        if self.visible {
            fs.focus();
        }
    }

    // ---- cabeçalho (`.settings-header`) ----
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: 49px;
        back := Rectangle {
            x: 18px;
            y: 10px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: bta.has-hover ? Theme.panel-3 : transparent;
            animate background { duration: 120ms; }
            StrokeIcon {
                size: 18px;
                commands: "M19 12H5 M12 19L5 12L12 5";
                stroke: bta.has-hover ? Theme.text : Theme.text-2;
            }
            bta := TouchArea {
                mouse-cursor: pointer;
                clicked => { St.close(); }
            }
            HintTrigger {
                hovered: bta.has-hover;
                hint: T.s("settings.buttons.back");
                layer: 3;
            }
        }
        Text {
            x: 18px + 28px + 10px;
            text: T.s("settings.title");
            font-size: 14px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.border;
        }
    }

    // ---- abas (`.settings-tabs`) ----
    Rectangle {
        x: 0;
        y: 49px;
        width: 190px;
        height: root.height - 49px;
        background: Theme.panel-2;
        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            background: Theme.border;
        }
        VerticalLayout {
            padding-top: 12px;
            padding-left: 8px;
            padding-right: 9px;
            spacing: 2px;
            alignment: start;
            TabButton { tab-id: "general"; label: T.s("settings.tabs.general"); }
            TabButton { tab-id: "onrecord"; label: T.s("settings.tabs.onrecord"); }
            TabButton { tab-id: "files"; label: T.s("settings.tabs.files"); }
            TabButton { tab-id: "recording"; label: T.s("settings.tabs.recording"); }
            TabButton { tab-id: "audio"; label: T.s("settings.tabs.audio"); }
            TabButton { tab-id: "replay"; label: T.s("settings.tabs.replay"); }
            TabButton { tab-id: "hotkeys"; label: T.s("settings.tabs.hotkeys"); }
            TabButton { tab-id: "devices"; label: T.s("settings.tabs.devices"); }
            TabButton { tab-id: "transcribe"; label: T.s("settings.tabs.transcribe"); }
            TabButton { tab-id: "updates"; label: T.s("settings.tabs.updates"); }
            TabButton { tab-id: "about"; label: T.s("settings.tabs.about"); }
        }
    }

    // ---- conteúdo (`.settings-body`): coluna de até 760 px ----
    property <length> body-w: root.width - 190px;
    property <length> col-w: min(760px, root.body-w - 36px);
    init => {
        St.rule-w = root.body-w - 36px;
        St.col-w = root.col-w;
    }
    changed body-w => {
        St.rule-w = root.body-w - 36px;
        St.col-w = root.col-w;
    }
    body := ScrollArea {
        x: 190px;
        y: 49px;
        width: root.body-w;
        height: root.height - 49px;
        content-h: content.preferred-height + 28px;
        content := VerticalLayout {
            x: 18px;
            y: 14px;
            width: root.col-w;
            height: self.preferred-height;
            alignment: start;
            // Na web o 1º campo de toda aba menos a Geral herda os 10 px do
            // `.settings-field + .settings-field` do campo ESCONDIDO da aba anterior.
            padding-top: St.tab == "general" ? 0 : 10px;
            if St.tab == "general": GeneralTab { }
            if St.tab == "onrecord": OnRecordTab { }
            if St.tab == "files": FilesTab { }
            if St.tab == "recording": VideoTab { }
            if St.tab == "audio": AudioTab { }
            if St.tab == "replay": ReplayTab { }
            if St.tab == "hotkeys": HotkeysTab { }
            if St.tab == "devices": DevicesTab { }
            if St.tab == "transcribe": TranscribeTab { }
            if St.tab == "updates": UpdatesTab { }
            if St.tab == "about": AboutTab { }
        }
    }
    // Cada aba começa do topo.
    property <string> tab: St.tab;
    changed tab => { body.set-scroll(0); }
}
