// A fila com arrastar pra reordenar (só os que esperam).
component TranscribeQueue {
    property <int> drag-from: -1;
    property <int> drop-at: -1;
    property <length> row-h: 30px;
    height: St.tr-queue.length * root.row-h + 2px;
    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border-2;
        clip: true;
        VerticalLayout {
            padding: 1px;
            for q[i] in St.tr-queue: QueueRow {
                item: q;
                first: i == 0;
                dragging: root.drag-from == i;
                drop-before: root.drag-from >= 0 && root.drop-at == i && i < root.drag-from;
                drop-after: root.drag-from >= 0 && root.drop-at == i && i > root.drag-from;
                removed => { St.tr-remove(q.id); }
                drag-start => {
                    root.drag-from = i;
                    root.drop-at = i;
                }
                drag-move(y) => {
                    root.drop-at = max(0, min(St.tr-queue.length - 1, i + floor(y / root.row-h)));
                }
                drag-end => {
                    if root.drag-from >= 0 && root.drop-at != root.drag-from && !St.tr-queue[root.drop-at].current {
                        St.tr-move(St.tr-queue[root.drag-from].id, root.drop-at);
                    }
                    root.drag-from = -1;
                    root.drop-at = -1;
                }
            }
        }
    }
}

