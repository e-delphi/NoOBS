// Estado das Configurações (`settings.js`, `hotkeys.js`, `transcribe.js`,
// `videotest.js` e o pedaço do `replay.js`/`displays.js` que mora nelas). Quem
// preenche é o `src/app_settings.rs`; cada mudança chama o core na hora (não
// há botão Salvar, como na web).

import { SelOpt } from "../widgets/form.slint";

// Pasta da lista "Pastas ocultas" (aba Arquivos).
export struct FolderRow {
    name: string,
    info: string,
    hidden: bool,
}

// Dispositivo das listas (aba Dispositivos e o perfil da gravação automática).
export struct DevRow {
    id: string,
    name: string,
    info: string,
    checked: bool,
}

export struct DevGroup {
    title: string,
    rows: [DevRow],
}

// Uma linha da aba Atalhos.
export struct HkRow {
    // record / window / area / replay → índice no seletor de modo.
    mode: int,
    ctrl: bool,
    shift: bool,
    alt: bool,
    win: bool,
    // Índice na lista de teclas (0 = "não definido").
    key: int,
    title: string,
    app-audio: bool,
    area-text: string,
    has-area: bool,
    area-button: string,
    delay: int,
    status: string,
    status-warn: bool,
}

// Uma linha da fila de transcrição.
export struct QItem {
    id: string,
    name: string,
    dur: string,
    current: bool,
}

// Um nível no resultado do teste de qualidade.
export struct VtLevel {
    level: int,
    name: string,
    fill: float,
    size: string,
    rel: string,
    current: bool,
    sel-a: bool,
    sel-b: bool,
}

export global St {
    in property <bool> open;
    in property <string> tab: "general";
    // Largura do corpo menos o padding: os divisores (`<hr>`) não têm o
    // limite de 760 px dos campos e atravessam tudo.
    in-out property <length> rule-w: 760px;
    // Largura da coluna dos campos (o comparador do teste tira a altura dela:
    // a própria largura ainda não existe quando o layout mede).
    in-out property <length> col-w: 760px;

    // ---- Geral ----
    in property <string> theme-pref: "system";
    in property <[SelOpt]> language-options;
    in property <int> language-index;
    in-out property <string> window-title;
    in property <bool> autostart;
    in property <bool> run-as-admin;
    in property <string> run-as-admin-state;
    in property <bool> close-to-tray;

    // ---- Arquivos ----
    in-out property <string> record-dir;
    in-out property <string> filename-pattern;
    in property <string> filename-preview;
    in property <int> library-index;
    in property <string> library-hint;
    in property <[FolderRow]> hidden-folders;

    // ---- Vídeo ----
    in property <[SelOpt]> codec-options;
    in property <int> codec-index;
    // amd / nvidia / intel / "" (o logo ao lado do codec).
    in property <string> gpu-vendor;
    in property <string> codec-maxres;
    in property <bool> codec-cpu-warn;
    in property <int> quality: 5;
    in property <string> quality-hint;
    in property <bool> quality-svt-warn;
    in property <[string]> fps-ticks;
    in property <int> fps-index;
    in property <string> fps-hint;
    in property <int> keyframe: 2;
    in property <string> keyframe-hint;

    // Teste de qualidade.
    in property <string> vt-button;
    in property <bool> vt-busy;
    in property <bool> vt-cancel-visible;
    in property <string> vt-status;
    in property <bool> vt-status-recording;
    in property <float> vt-progress: -1;
    in property <bool> vt-has-result;
    in property <string> vt-meta;
    in property <[VtLevel]> vt-levels;
    in property <[SelOpt]> vt-tag-options;
    in property <int> vt-a: 10;
    in property <int> vt-b: 10;
    in property <image> vt-img-a;
    in property <image> vt-img-b;
    in property <length> vt-img-w;
    in property <length> vt-img-h;
    // 0 = ajustar; 1, 2, 3 = 100/200/300 %.
    in property <int> vt-zoom;
    in-out property <float> vt-split: 0.5;
    in property <string> vt-use-label;
    in property <bool> vt-use-enabled;
    in property <bool> vt-playing;
    in property <float> vt-seek;
    in property <string> vt-time;
    in property <string> vt-swap-label;

    // ---- Áudio ----
    in property <[SelOpt]> audio-bitrate-options;
    in property <int> audio-bitrate-index;
    in property <string> audio-bitrate-hint;
    in property <bool> mute-when-muted;

    // ---- Buffer ----
    in property <bool> replay-autostart;
    in property <bool> replay-into-rec: true;
    in property <[SelOpt]> replay-sec-options;
    in property <int> replay-sec-index;
    in property <[SelOpt]> replay-mb-options;
    in property <int> replay-mb-index;
    in-out property <string> replay-apps;
    in property <bool> replay-indicator: true;
    in property <bool> replay-clickable: true;
    in property <int> replay-corner;
    in property <int> replay-opacity: 90;

    // ---- Atalhos ----
    in property <[HkRow]> hk-rows;
    in property <[SelOpt]> hk-mode-options;
    in property <[SelOpt]> hk-key-options;
    in property <[SelOpt]> hk-delay-options;
    in property <bool> hk-defining;

    // ---- Dispositivos ----
    in property <[DevGroup]> dev-groups;

    // ---- Gravação ----
    in property <bool> rec-indicator;
    in property <bool> rec-clickable: true;
    in property <int> rec-corner;
    in property <int> rec-opacity: 90;
    in property <bool> fullscreen-detect: true;
    in property <string> fullscreen-label;
    in property <string> fullscreen-hint;
    in property <bool> play-sound: true;
    in property <bool> minimize-on-record: true;
    in property <string> minimize-label;
    in property <string> minimize-hint;
    in property <bool> auto-record;
    in-out property <string> auto-apps;
    in-out property <string> auto-except;
    in property <[DevGroup]> auto-groups;
    in property <bool> stop-on-lock: true;

    // ---- Transcrição ----
    in property <string> asr-status;
    // "" / ok / fail
    in property <string> asr-kind;
    in property <float> asr-progress: -1;
    in property <string> asr-detail;
    in property <string> asr-button;
    in property <bool> asr-button-danger;
    in property <[SelOpt]> tr-lang-options;
    in property <int> tr-lang-index;
    in property <bool> tr-on-stop: true;
    in property <string> tr-pending-label;
    in property <bool> tr-pending-enabled;
    in property <string> tr-cancel-label;
    in property <bool> tr-cancel-enabled;
    in property <bool> tr-progress-visible;
    in property <float> tr-progress;
    in property <string> tr-line;
    in property <string> tr-error;
    in property <[QItem]> tr-queue;
    in property <string> tr-cloud-hint;

    // ---- Atualizações ----
    in property <string> app-version;
    in property <bool> check-updates: true;
    in property <string> update-status;
    in property <bool> update-available;
    in property <bool> update-has-url;
    in property <bool> update-checking;

    // Dicas com negrito/código (o `data-i18n-html` da web), montadas no Rust.
    in property <styled-text> md-filename-hint;
    in property <styled-text> md-replay-hint;
    in property <styled-text> md-rec-ind-hint;
    in property <styled-text> md-replay-ind-hint;
    in property <styled-text> md-about-2;
    in property <styled-text> md-about-3;
    in property <[styled-text]> md-features;
    in property <[styled-text]> md-built;
    in property <image> app-icon;

    // ---- chamadas ----
    callback close();
    callback show-tab(string);
    callback set-theme(string);
    callback language-selected(int);
    callback window-title-committed(string);
    callback check-changed(string, bool);
    callback restore-defaults();

    callback pick-folder();
    callback record-dir-committed(string);
    callback filename-edited(string);
    callback filename-committed(string);
    callback library-selected(int);
    callback folder-hidden(string, bool);

    callback codec-selected(int);
    callback quality-moved(int);
    callback quality-released();
    callback fps-moved(int);
    callback fps-released();
    callback keyframe-moved(int);
    callback keyframe-released();
    callback vt-start();
    callback vt-cancel();
    callback vt-pick(int, bool);
    callback vt-tag(int, bool);
    callback vt-swap();
    callback vt-zoom-set(int);
    callback vt-use();
    callback vt-toggle-play();
    callback vt-step(int);
    callback vt-seek-to(float);

    callback audio-bitrate-selected(int);

    callback replay-sec-selected(int);
    callback replay-mb-selected(int);
    callback replay-apps-edited(string);
    callback replay-apps-committed(string);
    callback replay-corner-selected(int);
    callback replay-opacity-moved(int);

    callback hk-mode(int, int);
    callback hk-mod(int, string, bool);
    callback hk-key(int, int);
    callback hk-title(int, string);
    callback hk-app-audio(int, bool);
    callback hk-define-area(int);
    callback hk-clear-area(int);
    callback hk-delay(int, int);
    callback hk-remove(int);
    callback hk-add();

    callback dev-toggled(string, bool);
    callback auto-dev-toggled(string, bool);

    callback rec-corner-selected(int);
    callback rec-opacity-moved(int);
    callback rec-opacity-released();
    callback auto-apps-edited(string);
    callback auto-apps-committed(string);
    callback auto-except-committed(string);

    callback asr-action();
    callback tr-lang-selected(int);
    callback tr-pending();
    callback tr-cancel();
    callback tr-remove(string);
    callback tr-move(string, int);

    callback check-now();
    callback open-update-page();
    callback open-repo();
}
