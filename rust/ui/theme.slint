// Tokens visuais: os MESMOS valores das variáveis do `css/base.css` da versão
// web (escuro = `:root`, claro = `:root[data-theme="light"]`). Nenhuma cor
// solta nas telas: tudo sai daqui, pra o tema trocar inteiro de uma vez.

export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #0a0a0c : #f4f4f5;
    out property <color> panel: dark ? #131316 : #ffffff;
    out property <color> panel-2: dark ? #1a1a1e : #fafafa;
    out property <color> panel-3: dark ? #202024 : #f4f4f5;
    out property <color> border: dark ? #26262b : #e4e4e7;
    out property <color> border-2: dark ? #36363c : #d4d4d8;
    out property <color> text: dark ? #e4e4e7 : #18181b;
    out property <color> text-2: dark ? #a1a1aa : #52525b;
    out property <color> text-3: #71717a;
    out property <color> accent: dark ? #3b82f6 : #2563eb;
    out property <color> accent-2: dark ? #60a5fa : #3b82f6;
    out property <color> accent-bg: dark ? rgba(59, 130, 246, 0.10) : rgba(37, 99, 235, 0.07);
    out property <color> accent-bd: dark ? rgba(59, 130, 246, 0.20) : rgba(37, 99, 235, 0.18);
    out property <color> danger: #dc2626;
    out property <color> danger-2: #ef4444;
    out property <color> success: dark ? #10b981 : #059669;
    out property <brush> thumb-bg: dark
        ? @linear-gradient(135deg, #1f1f23 0%, #0f0f12 100%)
        : @linear-gradient(135deg, #e4e4e7 0%, #d4d4d8 100%);
    out property <color> thumb-fg: dark ? rgba(255, 255, 255, 0.3) : rgba(0, 0, 0, 0.22);

    // Sombras (`--shadow-sm` / `--shadow-md`).
    out property <color> shadow-sm: dark ? rgba(0, 0, 0, 0.4) : rgba(0, 0, 0, 0.06);
    out property <color> shadow-md: dark ? rgba(0, 0, 0, 0.4) : rgba(0, 0, 0, 0.08);

    // Âmbar dos avisos (`.toast.warn`, `.banner`): igual nos dois temas.
    out property <color> warn-bg: #facc15;
    out property <color> warn-border: #ca8a04;
    out property <color> warn-text: #1c1917;
    out property <color> warn-text-2: #44403c;

    // Tipografia do `body`: a pilha do CSS cai no Segoe UI no Windows (Inter
    // não vem instalada). Mono = `"SF Mono", "Cascadia Code", Consolas`.
    // O Segoe UI do Windows tem 400, 600 e 700 — sem 500. O Chromium desenha o
    // `font-weight: 500` do CSS com o semibold (600), e é esse o visual da web:
    // nas telas, o 500 do CSS vira 600 aqui (medido lado a lado).
    out property <string> font: "Segoe UI";
    out property <string> mono: "Cascadia Code";
    out property <length> font-size: 13px;
    // `line-height` do CSS é múltiplo do TAMANHO da fonte; o
    // `line-height-factor` do Slint é múltiplo da altura NATURAL da linha,
    // que no Segoe UI é 1,33 × o tamanho ((2210 + 514) / 2048). Daí
    // fator = css / 1,33: o 1,4 do `body` vira 1,053.
    out property <float> lh-body: 1.4 / 1.33;
}
