// Controles de formulário das Configurações (`css/settings.css`): rótulo,
// dica, aviso, divisor, caixa de marcar, campo de texto, seletor, botão,
// slider com marcas e a prévia do indicador.
//
// `<input>`, `<select>` e `<button>` NÃO herdam a fonte da página no Chromium:
// saem na fonte padrão de formulário, Arial 13 px. Daí o `font-family` deles
// ser Arial aqui e o resto Segoe UI.

import { Theme } from "../theme.slint";
import { SelOpt, SelPop } from "select_layer.slint";

export { SelOpt }

export global Form {
    // Fonte dos controles nativos do formulário.
    out property <string> control-font: "Arial";
    // `line-height: 1.4` sobre 11 px.
    out property <float> lh-hint: 1.4 / 1.33;
}

// `.settings-field label`: 12 px, 500 (sai 600 no Segoe UI), `--text-2`.
export component SLabel inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.text-2;
}

// `.settings-hint`: 11 px, `--text-3`, linha 1,4.
export component SHint inherits Text {
    font-size: 11px;
    color: Theme.text-3;
    wrap: word-wrap;
    line-height-factor: Form.lh-hint;
}

// `.settings-warn`: âmbar com barra à esquerda.
export component SWarn {
    in property <string> text;
    Rectangle {
        x: 0;
        width: 2px;
        background: #f59e0b;
    }
    t := Text {
        x: 10px;
        width: parent.width - 10px;
        text: root.text;
        font-size: 11px;
        color: Theme.dark ? #fbbf24 : #b45309;
        wrap: word-wrap;
        line-height-factor: Form.lh-hint;
    }
    height: t.preferred-height;
}

// `.settings-divider`.
export component SDivider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// `<input type="checkbox">` com `accent-color: var(--success)`, 16 px.
export component CheckBox {
    in property <bool> checked;
    in property <length> size: 16px;
    // Desativada: o cinza do Chromium (sem a cor de destaque).
    in property <bool> disabled;
    width: root.size;
    height: root.size;
    Rectangle {
        border-radius: 2px;
        border-width: root.checked ? 0 : 1px;
        border-color: root.disabled ? #8f8f8f : #767676;
        background: root.disabled ? (root.checked ? #949494 : #a5a5a5) : root.checked ? Theme.success : white;
    }
    if root.checked: Path {
        width: root.size;
        height: root.size;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.disabled ? #d0d0d0 : #1f2320;
        stroke-width: root.size * 2.2 / 16;
        fill: transparent;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M3.6 8.4L6.6 11.3L12.4 4.9";
    }
}

// `.settings-check-row`: caixa + texto (o rótulo é um `<label>`: 12 px, 500).
export component SCheck {
    in property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-height: max(16px, lbl.preferred-height);
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            CheckBox { checked: root.checked; }
        }
        lbl := Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-2;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => {
            if root.enabled {
                root.toggled(!root.checked);
            }
        }
    }
}

// `.settings-input` (texto): fundo `--panel-2`, borda verde no foco.
export component SInput {
    in-out property <string> text;
    in property <string> placeholder;
    in property <int> max-length: 0;
    out property <bool> has-focus: input.has-focus;
    // A cada tecla (`input`) e ao sair do campo / Enter (`change`).
    callback edited(string);
    callback committed(string);
    height: 32px;
    min-width: 40px;
    public function focus-input() {
        input.focus();
    }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: input.has-focus ? Theme.success : Theme.border;
        background: Theme.panel-2;
        animate border-color { duration: 150ms; }
    }
    Text {
        x: 11px;
        width: parent.width - 22px;
        visible: input.text == "";
        text: root.placeholder;
        font-family: Form.control-font;
        font-size: 13px;
        color: Theme.text-3;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 11px;
        width: parent.width - 22px;
        text <=> root.text;
        font-family: Form.control-font;
        font-size: 13px;
        color: Theme.text;
        single-line: true;
        vertical-alignment: center;
        selection-background-color: Theme.accent;
        edited => {
            if root.max-length > 0 && self.text.character-count > root.max-length {
                return;
            }
            root.edited(self.text);
        }
        accepted => { root.committed(self.text); }
        changed has-focus => {
            if !self.has-focus {
                root.committed(self.text);
            }
        }
    }
}

// `.settings-btn`: 13 px, padding 8 14, raio 6. `primary` = verde.
export component SButton {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> active;
    // Variantes compactas (`.vtest-ab .settings-btn`: 6 10, 12 px).
    in property <length> pad-x: 14px;
    in property <length> pad-y: 8px;
    in property <length> font-size: 13px;
    callback clicked();
    height: lbl.preferred-height + 2 * root.pad-y + 2px;
    width: lbl.preferred-width + 2 * root.pad-x + 2px;
    // `.settings-btn:disabled` não tem estilo na web: só deixa de responder.
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: root.primary ? Theme.success
            : root.active ? Theme.success
            : (ta.has-hover && root.enabled ? Theme.border-2 : Theme.border);
        background: root.primary ? (ta.has-hover && root.enabled ? Theme.success.brighter(10%) : Theme.success)
            : (ta.has-hover && root.enabled ? Theme.panel-3 : Theme.panel-2);
        animate background, border-color { duration: 150ms; }
    }
    lbl := Text {
        text: root.text;
        font-family: Form.control-font;
        font-size: root.font-size;
        color: root.primary ? white : root.danger ? Theme.danger-2 : root.active ? Theme.success : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

// `select.settings-input`: caixa com a seta desenhada e a lista que abre por
// cima (o popup nativo do `<select>`).
export component SSelect {
    in property <[SelOpt]> options;
    in property <int> index;
    in property <bool> enabled: true;
    in property <length> font-size: 13px;
    callback selected(int);
    height: 32px;
    min-width: 60px;
    opacity: root.enabled ? 1 : 0.5;
    property <length> item-h: 22px;
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: root.pop-open ? Theme.success : Theme.border;
        background: Theme.panel-2;
    }
    // A lista é a camada `SelectLayer` (select_layer.slint): cada seletor pega
    // um `uid` e só reage à escolha feita na lista que ele abriu.
    property <int> uid;
    init => {
        root.uid = SelPop.next-id;
        SelPop.next-id += 1;
    }
    property <bool> pop-open: SelPop.open && SelPop.owner == root.uid;
    property <int> seq: SelPop.result-seq;
    changed seq => {
        if SelPop.owner == root.uid {
            root.selected(SelPop.result);
        }
    }
    Text {
        x: 11px;
        width: parent.width - 11px - 28px;
        text: root.index >= 0 && root.index < root.options.length ? root.options[root.index].text : "";
        font-family: Form.control-font;
        font-size: root.font-size;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    // A seta: dois triângulos de 5 px a 16 e 11 px da direita (o
    // `background-image` do CSS), formando um "v" cheio.
    Path {
        x: parent.width - 18px;
        y: (parent.height - 5px) / 2 - 1px;
        width: 10px;
        height: 5px;
        viewbox-width: 10;
        viewbox-height: 5;
        fill: Theme.text;
        commands: "M0 0L10 0L5 5Z";
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                SelPop.show(root.uid, root.options, root.index, self.absolute-position.x, self.absolute-position.y + root.height + 1px,
                    root.width, root.height, 0);
            }
        }
    }
}

// Slider customizado da web (`.quality-slider-row input[type=range]`): trilha
// de 4 px com a parte cheia em verde até o centro do botão de 14 px. `value`
// é o índice 0..steps; com `ticks`, os rótulos ficam embaixo, centrados no
// botão naquela posição (`left = 7px + r × (100% − 14px)`).
export component SSlider {
    in property <int> steps: 10;
    in property <int> value;
    in property <[string]> ticks;
    callback changed-value(int);
    // Soltou o botão (o `change` do range; o `input` é o `changed-value`).
    callback released();
    property <float> ratio: root.steps > 0 ? root.value / root.steps : 0;
    property <length> knob-x: 7px + root.ratio * (root.width - 14px);
    height: root.ticks.length > 0 ? 16px + 2px + 14px : 16px;
    Rectangle {
        y: 6px;
        height: 4px;
        border-radius: 2px;
        background: Theme.border-2;
    }
    Rectangle {
        x: 0;
        y: 6px;
        width: root.knob-x;
        height: 4px;
        border-radius: 2px;
        background: Theme.success;
    }
    Rectangle {
        x: root.knob-x - 7px;
        y: 1px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.success;
    }
    for t[i] in root.ticks: Text {
        x: 7px + (root.ticks.length > 1 ? i / (root.ticks.length - 1) : 0) * (root.width - 14px) - self.preferred-width / 2;
        y: 18px;
        text: t;
        font-size: 10px;
        color: Theme.text-3;
    }
    function value-at(x: length) -> int {
        return max(0, min(root.steps, round((x - 7px) / max(1px, root.width - 14px) * root.steps)));
    }
    TouchArea {
        height: 16px;
        y: 0;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.changed-value(root.value-at(self.mouse-x));
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                root.released();
            }
        }
        moved => {
            if self.pressed {
                root.changed-value(root.value-at(self.mouse-x));
            }
        }
    }
}

// Prévia do indicador de tela (`.rec-indicator-preview`): pílula escura com a
// bolinha e o tempo; a opacidade acompanha o slider.
export component IndicatorPreview {
    in property <bool> buffer;
    in property <string> text;
    height: 20px;
    width: tx.preferred-width + 8px + 8px + 6px + 16px;
    Rectangle {
        border-radius: 8px;
        background: #18181b;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 3px;
        drop-shadow-color: rgba(0, 0, 0, 0.35);
    }
    Rectangle {
        x: 8px;
        y: (parent.height - 8px) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.buffer ? #10b981 : #f03e3e;
    }
    tx := Text {
        x: 8px + 8px + 6px;
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.3px;
        color: white;
        vertical-alignment: center;
    }
}
