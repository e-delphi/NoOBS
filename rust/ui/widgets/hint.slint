// Dica (o `data-hint` + objeto `Hint` da versão web): aparece 400 ms depois
// de o mouse parar sobre o alvo, some ao sair ou clicar. Abaixo do alvo e
// centralizada; se não couber embaixo, vai pra cima; presa a 6 px das bordas.
//
// Uso: dentro do elemento que tem a dica, um `HintTrigger` que lê o hover do
// TouchArea dele —
//     ta := TouchArea { }
//     HintTrigger { hovered: ta.has-hover; pressed: ta.pressed; hint: "…"; }
// O `HintTrigger` ocupa o pai inteiro: a posição e o tamanho dele SÃO os do
// alvo. Só existe um balão (`HintBubble`, na raiz da janela).

import { Theme } from "../theme.slint";

export global Hints {
    in-out property <string> text;
    in-out property <bool> visible;
    // Retângulo do alvo, em coordenadas da janela.
    in-out property <length> ax;
    in-out property <length> ay;
    in-out property <length> aw;
    in-out property <length> ah;
}

export component HintTrigger {
    in property <bool> hovered;
    in property <bool> pressed;
    in property <string> hint;
    width: 100%;
    height: 100%;

    timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if root.hint != "" {
                Hints.text = root.hint;
                Hints.ax = root.absolute-position.x;
                Hints.ay = root.absolute-position.y;
                Hints.aw = root.width;
                Hints.ah = root.height;
                Hints.visible = true;
            }
        }
    }

    changed hovered => {
        if self.hovered {
            timer.running = true;
        } else {
            timer.running = false;
            Hints.visible = false;
        }
    }
    changed pressed => {
        if self.pressed {
            timer.running = false;
            Hints.visible = false;
        }
    }
}

// O balão. Vai por último na raiz da janela (por cima de tudo, como o
// `z-index: 9900` da web) e não recebe o mouse.
export component HintBubble {
    in property <length> win-w;
    in property <length> win-h;
    property <length> gap: 6px;
    property <length> margin: 6px;
    property <length> bw: min(320px, label.preferred-width + 22px);
    property <length> bh: label-h + 14px;
    property <length> label-h: label.preferred-height;
    // Abaixo e centralizado; estourando embaixo, acima; preso nas bordas.
    property <length> below: Hints.ay + Hints.ah + gap;
    property <length> top: below + bh + margin > win-h ? Hints.ay - bh - gap : below;
    property <length> left: Hints.ax + (Hints.aw - bw) / 2;

    x: max(margin, min(left, win-w - bw - margin));
    y: max(margin, top) + (Hints.visible ? 0 : -3px);
    width: bw;
    height: bh;
    opacity: Hints.visible ? 1 : 0;
    animate opacity, y { duration: 120ms; easing: ease; }

    Rectangle {
        background: Theme.dark ? Theme.panel-3 : #ffffff;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.dark ? rgba(255, 255, 255, 0.10) : rgba(0, 0, 0, 0.10);
        drop-shadow-offset-y: 6px;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.dark ? rgba(0, 0, 0, 0.40) : rgba(0, 0, 0, 0.15);
    }
    label := Text {
        x: 11px;
        y: 7px;
        width: root.bw - 22px;
        text: Hints.text;
        font-family: Theme.font;
        font-size: 12px;
        color: Theme.dark ? Theme.text : #1f2937;
        wrap: word-wrap;
        line-height-factor: 1.45 / 1.33;
    }
}
