// Área com rolagem e a barra fina da versão web (`::-webkit-scrollbar` do
// widgets.css: 8 px, polegar `--border-2` com raio 4, `--text-3` no hover,
// trilho transparente). A barra só aparece quando há o que rolar.

import { Theme } from "../theme.slint";

export component ScrollArea {
    // Altura do conteúdo (quem usa passa o `preferred-height` do layout de dentro).
    in property <length> content-h;
    // Posição da rolagem (negativa ou zero); quem usa pode ler e mover.
    out property <length> content-y: flick.content-y;
    // Rola até y (negativo ou zero), preso aos limites.
    public function set-scroll(y: length) {
        flick.content-y = max(-root.max-scroll, min(0px, y));
    }
    property <length> max-scroll: max(0px, root.content-h - root.height);
    // Pixels por "linha" da roda. O Slint anda 60 px por linha; o Chromium
    // anda 100 px por clique da roda (3 linhas de 33 px) — a lista andava
    // pouco por clique comparada à web.
    in property <float> wheel-mult: 100 / 60;

    flick := Flickable {
        width: root.width;
        height: root.height;
        content-width: root.width;
        content-height: max(root.height, root.content-h);
        // Como na web: o mouse não arrasta o conteúdo (só roda e toque). Sem
        // isto, arrastar um card rolava a lista em vez de mover o card.
        mouse-drag-pan-enabled: false;
        // A roda é tratada aqui (ancestral dos filhos, dentro do Flickable):
        // o que os filhos não usam sobe até este TouchArea, que rola na
        // velocidade da web antes do Flickable ver o evento.
        TouchArea {
            scroll-event(e) => {
                if root.max-scroll <= 0 || e.delta-y == 0 {
                    return reject;
                }
                flick.content-y = max(-root.max-scroll, min(0px, flick.content-y + e.delta-y * root.wheel-mult));
                accept
            }
            @children
        }
    }

    if root.max-scroll > 0: Rectangle {
        x: root.width - 8px;
        width: 8px;
        property <length> thumb-h: max(24px, root.height * root.height / root.content-h);
        thumb := Rectangle {
            y: (root.height - self.height) * (-flick.content-y / root.max-scroll);
            height: parent.thumb-h;
            border-radius: 4px;
            background: ta.has-hover || ta.pressed ? Theme.text-3 : Theme.border-2;
            ta := TouchArea {
                property <length> start-y;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        self.start-y = flick.content-y;
                    }
                }
                moved => {
                    if self.pressed {
                        flick.content-y = max(-root.max-scroll, min(0px,
                            self.start-y - (self.mouse-y - self.pressed-y) * root.max-scroll / (root.height - parent.height)));
                    }
                }
            }
        }
    }
}
