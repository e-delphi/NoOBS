// Lista dos seletores (o popup nativo do `<select>`), desenhada numa camada
// por cima da janela inteira em vez de um `PopupWindow`.
//
// O `PopupWindow` do Slint mostrava a lista mas o clique nunca chegava à
// opção: a lista fechava como se o clique fosse fora dela (visto nas
// Configurações, dentro da área rolável). Aqui é o mesmo esquema do menu de
// contexto da biblioteca: um global guarda a lista aberta e quem a abriu, a
// camada (`SelectLayer`, no topo do `app.slint`) desenha e devolve a escolha,
// e só o seletor dono (`owner` = o `uid` que cada um pega no `init`) reage.

import { Theme } from "../theme.slint";
import { ScrollArea } from "scroll.slint";

// Uma opção de seletor. `header` = título de grupo (`<optgroup>`), não
// escolhível.
export struct SelOpt {
    text: string,
    header: bool,
    enabled: bool,
}

export global SelPop {
    in-out property <bool> open;
    in-out property <int> owner;
    in-out property <int> next-id: 1;
    in-out property <[SelOpt]> options;
    in-out property <int> index;
    // Onde a lista nasce (logo abaixo do seletor), na janela.
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> w;
    // Altura do seletor: sem espaço embaixo, a lista abre acima dele.
    in-out property <length> anchor-h;
    // 0 = Configurações (13 px), 1 = exportação (12 px), 2 = etiqueta de nível.
    in-out property <int> style;
    // Texto antes de cada opção (a etiqueta "A · " / "B · " do teste).
    in-out property <string> prefix;
    in-out property <int> result;
    in-out property <int> result-seq;

    public function show(id: int, opts: [SelOpt], idx: int, x: length, y: length, w: length, h: length, style: int) {
        self.owner = id;
        self.options = opts;
        self.index = idx;
        self.x = x;
        self.y = y;
        self.w = w;
        self.anchor-h = h;
        self.style = style;
        self.prefix = "";
        self.open = true;
    }

    public function pick(i: int) {
        self.result = i;
        self.open = false;
        self.result-seq += 1;
    }
}

export component SelectLayer {
    property <length> item-h: SelPop.style == 2 ? 20px : 22px;
    property <length> pad: SelPop.style == 2 ? 3px : 3px;
    property <length> list-h: min(SelPop.options.length * root.item-h + 2 * root.pad, 320px);
    // Sem espaço embaixo (e com espaço em cima): abre acima do seletor.
    property <bool> above: SelPop.y + root.list-h > root.height - 4px
        && SelPop.y - SelPop.anchor-h - 2px - root.list-h >= 0;

    // Clique fora (ou roda) fecha, sem chegar no que está embaixo.
    if SelPop.open: TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                SelPop.open = false;
            }
        }
        scroll-event(e) => {
            SelPop.open = false;
            accept
        }
    }

    if SelPop.open: Rectangle {
        x: min(SelPop.x, root.width - self.width);
        y: root.above ? SelPop.y - SelPop.anchor-h - 2px - root.list-h : SelPop.y;
        width: SelPop.style == 2 ? max(SelPop.w, 120px) : SelPop.w;
        height: root.list-h;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border-2;
        background: SelPop.style == 2 ? Theme.panel : (Theme.dark ? #2b2b2f : #ffffff);
        drop-shadow-offset-y: SelPop.style == 2 ? 0 : 4px;
        drop-shadow-blur: SelPop.style == 2 ? 0 : 12px;
        drop-shadow-color: rgba(0, 0, 0, 0.4);
        // A lista come o clique (senão o TouchArea de fora fecharia antes).
        TouchArea { }
        ScrollArea {
            x: 1px;
            y: root.pad;
            width: parent.width - 2px;
            height: parent.height - 2 * root.pad;
            content-h: SelPop.options.length * root.item-h;
            VerticalLayout {
                for opt[i] in SelPop.options: Rectangle {
                    height: root.item-h;
                    background: opt.header ? transparent
                        : SelPop.style == 2 ? (ita.has-hover ? Theme.panel-3 : (i == SelPop.index ? Theme.panel-2 : transparent))
                        : ita.has-hover ? (Theme.dark ? #3f3f46 : #e4e4e7)
                        : i == SelPop.index ? (Theme.dark ? rgba(255, 255, 255, 0.08) : rgba(0, 0, 0, 0.05)) : transparent;
                    Text {
                        x: SelPop.style == 2 ? 7px : SelPop.style == 1 ? 10px : opt.header ? 6px : 14px;
                        width: parent.width - self.x - 6px;
                        text: SelPop.prefix + opt.text;
                        font-family: SelPop.style == 2 ? Theme.font : "Arial";
                        font-size: SelPop.style == 0 ? 13px : 12px;
                        font-weight: opt.header ? 700 : 400;
                        color: !opt.enabled ? Theme.text-3 : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ita := TouchArea {
                        enabled: !opt.header && opt.enabled;
                        clicked => { SelPop.pick(i); }
                    }
                }
            }
        }
    }
}
