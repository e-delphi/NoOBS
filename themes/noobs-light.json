{
  "name": "NoOBS Light",
  "base": "Iron Light",
  "family": "NoOBS",
  "dark": false,
  "colors": {
    "background": "#F4F4F5",
    "surface": "#FFFFFF",
    "surface_2": "#FAFAFA",
    "surface_3": "#F4F4F5",
    "border": "#E4E4E7",
    "border_2": "#D4D4D8",
    "text": "#18181B",
    "text_muted": "#52525B",
    "text_3": "#71717A",
    "primary": "#2563EB",
    "primary_hover": "#3B82F6",
    "primary_pressed": "#1D4ED8",
    "on_primary": "#FFFFFF",
    "primary_soft": "#2563EB12",
    "primary_border": "#2563EB2E",
    "focus_ring": "#2563EB",
    "selection": "#2563EB33",
    "danger": "#DC2626",
    "danger_hover": "#EF4444",
    "success": "#059669",
    "warning": "#FACC15",
    "warning_border": "#CA8A04",
    "warning_text": "#1C1917",
    "warning_text_2": "#44403C",
    "thumb_fg": "#00000038",
    "shadow": "#00000014",
    "track": "#D4D4D8",
    "hover_overlay": "#0000000A",
    "meter_low": "#059669",
    "meter_mid": "#F59E0B",
    "meter_high": "#EF4444",
    "on_warning": "#1C1917",
    "row_hover": "#F4F4F5"
  },
  "styles": {
    "Panel.column": { "fill": "surface", "border": ["border", 0], "radius": 0 },
    "Panel.pane": { "fill": "background", "border": ["border", 0], "radius": 0 },
    "Panel.card": { "fill": "surface_2", "border": ["border", 1], "radius": 12 },
    "Panel.box": { "fill": "surface_2", "border": ["border", 1], "radius": 8 },
    "Panel.row": { "fill": "#00000000", "border": ["border", 0], "radius": 7, "hover": { "fill": "row_hover" } },
    "Panel.row_active": { "fill": "primary_soft", "border": ["primary_border", 1], "radius": 7 },
    "Panel.flat": { "fill": "#00000000", "border": ["border", 0], "radius": 0, "hover": { "fill": "row_hover" } },
    "Switch": { "fill": "border_2", "border": ["border", 0], "checked": { "fill": "success" }, "disabled": { "opacity": 0.5 } },
    "Panel.scrim": { "fill": "#0000008C", "border": ["border", 0], "radius": 0 },
    "Panel.dialog": { "fill": "surface", "border": ["border", 1], "radius": 12, "shadow": "lg" },
    "Panel.wcard": { "fill": "surface_2", "border": ["border", 1], "radius": 9, "hover": { "fill": "surface_3", "border": ["border_2", 1] } },
    "Label.title": { "text": "text", "font": "title" },
    "Label.body": { "text": "text_muted", "font": "body" },
    "Panel.player": { "fill": "#000000", "border": ["border", 0], "radius": 0 },
    "Panel.plbar": { "fill": "#0A0A0CD9", "border": ["border", 0], "radius": 0 },
    "Panel.plside": { "fill": "surface", "border": ["border", 0], "radius": 0 },
    "Button.pl": { "fill": "#00000000", "text": "#FFFFFFE6", "border": ["border", 0], "radius": 8, "padding": [0, 0], "hover": { "fill": "#FFFFFF1F", "text": "#FFFFFF" }, "pressed": { "fill": "#FFFFFF33" }, "checked": { "fill": "#FFFFFF26", "text": "#FFFFFF" } },
    "Label.pl_title": { "text": "#FFFFFF", "font": "title" },
    "Label.pl_time": { "text": "#FFFFFFD9", "font": "pl_time" },
    "Label.pl_badge": { "text": "#F59E0B", "font": "caption" },
    "Label.pl_caption": { "text": "#FFFFFF", "font": "pl_caption" },
    "Label.key": { "text": "text_3", "font": "body" },
    "Label.val": { "text": "text", "font": "body" },
    "LevelMeter": { "fill": "surface_3", "border": ["border", 0], "radius": 1.5 },
    "Rectangle.stripe": { "fill": "border", "border": ["border", 0], "radius": 0 },
    "Rectangle.edge": { "fill": "border", "border": ["border", 0], "radius": 0 },
    "Rectangle.sep": { "fill": "border", "border": ["border", 0], "radius": 0 },
    "Label.section": { "text": "text_3", "font": "caption" },
    "Label.count": { "text": "text_3", "font": "count" },
    "Label.status": { "text": "text_muted", "font": "status" },
    "Label.timer": { "text": "text", "font": "timer" },
    "Label.timer_ms": { "text": "text_3", "font": "timer_ms" },
    "Label.size": { "text": "text_3", "font": "mono" },
    "Label.action": { "text": "text_muted", "font": "action" },
    "Label.row": { "text": "text", "font": "row" },
    "Label.sub": { "text": "text_3", "font": "small" },
    "Label.legend": { "text": "text_muted", "font": "legend" },
    "Label.legend_track": { "text": "text", "font": "legend_track" },
    "Label.h2": { "text": "text", "font": "h2" },
    "Label.meta": { "text": "text_3", "font": "meta" },
    "Button.tool": {
      "fill": "#00000000", "text": "text_muted", "border": ["border_2", 1], "radius": 7, "padding": [0, 0],
      "hover": { "fill": "surface_3", "text": "text" },
      "pressed": { "fill": "border" },
      "disabled": { "opacity": 0.4 }
    }
  },
  "fonts": {
    "default": { "family": "Segoe UI", "size": 13 },
    "mono": { "family": "Cascadia Code", "size": 12 },
    "caption": { "family": "Segoe UI", "size": 10, "weight": "semi_bold" },
    "count": { "family": "Segoe UI", "size": 11, "weight": "semi_bold" },
    "status": { "family": "Segoe UI", "size": 10 },
    "timer": { "family": "Cascadia Code", "size": 38, "weight": "light" },
    "timer_ms": { "family": "Cascadia Code", "size": 22, "weight": "light" },
    "action": { "family": "Segoe UI", "size": 11, "weight": "semi_bold" },
    "row": { "family": "Segoe UI", "size": 12, "weight": "semi_bold" },
    "small": { "family": "Segoe UI", "size": 10.5 },
    "legend": { "family": "Segoe UI", "size": 11.5 },
    "legend_track": { "family": "Segoe UI", "size": 11.5, "weight": "semi_bold" },
    "h2": { "family": "Segoe UI", "size": 16, "weight": "semi_bold" },
    "meta": { "family": "Segoe UI", "size": 11 },
    "title": { "family": "Segoe UI", "size": 14, "weight": "semi_bold" },
    "body": { "family": "Segoe UI", "size": 12 },
    "pl_time": { "family": "Segoe UI", "size": 13 },
    "pl_caption": { "family": "Segoe UI", "size": 22, "weight": "semi_bold" }
  }
}
